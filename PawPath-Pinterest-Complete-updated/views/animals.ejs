<%- include('partials/header') %>
<section class="page-heading"><p class="eyebrow">LOCAL RESCUE NETWORK</p><h1>Find someone who needs you.</h1><p>Search active adoption, foster, SOS and community-care profiles.</p></section>
<section class="filters-panel"><form method="get" action="/animals" class="filter-form"><input type="search" name="q" placeholder="Search name, locality or keyword" value="<%= filters.q %>"><select name="species"><option value="">All species</option><% ['Dog','Cat'].forEach(x => { %><option <%= filters.species===x?'selected':'' %>><%= x %></option><% }) %></select><select name="category"><option value="">All needs</option><% ['Up for Adoption','Urgent Foster Needed','Medical / Rescue SOS','Community Feeder Spot'].forEach(x => { %><option <%= filters.category===x?'selected':'' %>><%= x %></option><% }) %></select><select name="urgency"><option value="">Any urgency</option><% ['Critical','Needs Help Today','Normal'].forEach(x => { %><option <%= filters.urgency===x?'selected':'' %>><%= x %></option><% }) %></select><select name="vaccinated"><option value="">Vaccination status</option><% ['Yes','No','Partially'].forEach(x => { %><option <%= filters.vaccinated===x?'selected':'' %>><%= x %></option><% }) %></select><select name="status"><option value="">Any rescue status</option><% ['Reported','Under Care','Foster Needed','Adoption Pending','Adopted','Resolved'].forEach(x => { %><option <%= filters.status===x?'selected':'' %>><%= x %></option><% }) %></select><select name="sort"><option value="newest" <%= filters.sort==='newest'?'selected':'' %>>Newest first</option><option value="urgency" <%= filters.sort==='urgency'?'selected':'' %>>Most urgent first</option></select><button class="button" type="submit">Apply filters</button><a class="text-link" href="/animals">Clear all</a></form></section>
<section class="section results"><p class="results-count"><strong><%= animals.length %></strong> profile<%= animals.length===1?'':'s' %> found</p><div class="card-grid"><% if (animals.length) { animals.forEach(animal => { %><%- include('partials/animal-card', { animal }) %><% }) } else { %><div class="empty-state"><h2>No profiles match those filters.</h2><p>Try a wider search, or clear the filters.</p><a class="button" href="/animals">Explore all profiles</a></div><% } %></div></section>
<%- include('partials/footer') %>
