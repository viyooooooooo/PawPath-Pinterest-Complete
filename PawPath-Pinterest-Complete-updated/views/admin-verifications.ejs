<%- include('partials/header') %><section class="page-heading"><span class="kicker">REVIEWER WORKSPACE</span><h1>Verification applications</h1><p>Check identity and residence references privately, confirm the veterinary reference independently, and record a reason before making a decision.</p></section><section class="section"><div class="request-list"><% if (applications.length) { applications.forEach(item => { %><article class="review-card"><div><span class="badge"><%= item.status %></span><h2><%= item.full_name %></h2><p><b><%= item.applicant_type %></b> · <%= item.username %> · <%= item.email %></p><p><b>Residence:</b> <%= item.address %><br><b>ID reference:</b> <%= item.government_id_type %> — <%= item.government_id_reference %><br><b>Residence proof:</b> <%= item.residence_proof_reference %></p><p><b>Veterinary reference:</b> <%= item.veterinarian_name %>, <%= item.veterinarian_clinic %> · <%= item.veterinarian_contact %></p><p><b>Experience:</b> <%= item.pet_experience %></p></div><form method="post" action="/admin/verifications/<%= item.id %>/decision"><label>Private reviewer notes<textarea name="reviewer_notes"><%= item.reviewer_notes || '' %></textarea></label><div class="hero-actions"><button class="button" name="decision" value="approve">Approve</button><button class="button button-soft" name="decision" value="reject">Reject</button></div></form></article><% }) } else { %><div class="empty-state">No verification applications yet.</div><% } %></div></section><%- include('partials/footer') %>
