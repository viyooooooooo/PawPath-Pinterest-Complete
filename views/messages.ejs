<%- include('partials/header') %>
<section class="inbox-page"><div class="inbox-heading"><div><span class="kicker">PAWPATH INBOX</span><h1>Messages</h1><p>Every conversation keeps its animal, offer and next step attached.</p></div><a class="button button-soft" href="/notifications">Open notifications</a></div><div class="inbox-shell"><div class="inbox-sidebar"><label class="inbox-search">⌕<input type="search" placeholder="Search conversations" data-conversation-search></label><div class="inbox-filter"><button class="active" type="button">All</button><button type="button" data-unread-filter>Unread</button></div></div><div class="conversation-list modern-list">
<% if (conversations.length) { conversations.forEach(conversation => { %><a class="conversation-row <%= conversation.unread_count ? 'is-unread' : '' %>" href="/messages/<%= conversation.id %>" data-conversation-row data-unread="<%= conversation.unread_count ? '1' : '0' %>"><span class="conversation-avatar"><% if (conversation.other_photo) { %><img src="<%= conversation.other_photo %>" alt=""><% } else { %><%= conversation.other_username.charAt(0).toUpperCase() %><% } %></span><div class="conversation-preview"><div><strong><%= conversation.other_username %></strong><time><%= new Date(conversation.last_message_at).toLocaleDateString(undefined,{month:'short',day:'numeric'}) %></time></div><h3><%= conversation.topic === 'General question' ? 'Direct message' : conversation.topic %></h3><p><%= conversation.last_message %></p></div><% if (conversation.listing_photo) { %><img class="conversation-listing-thumb" src="<%= conversation.listing_photo %>" alt=""><% } %><% if (conversation.unread_count) { %><span class="unread-count"><%= conversation.unread_count %></span><% } %></a><% }) } else { %><div class="empty-state"><h2>No conversations yet.</h2><p>Message a community member or send a help offer to start one.</p><a class="button" href="/profiles">Find PawPath members</a></div><% } %>
</div></div></section><script>document.addEventListener('DOMContentLoaded',()=>{const q=document.querySelector('[data-conversation-search]');const rows=[...document.querySelectorAll('[data-conversation-row]')];q?.addEventListener('input',()=>rows.forEach(r=>r.hidden=!r.textContent.toLowerCase().includes(q.value.toLowerCase())));document.querySelector('[data-unread-filter]')?.addEventListener('click',e=>{e.currentTarget.classList.toggle('active');rows.forEach(r=>r.hidden=e.currentTarget.classList.contains('active')&&r.dataset.unread!=='1')})})</script>
<%- include('partials/footer') %>
