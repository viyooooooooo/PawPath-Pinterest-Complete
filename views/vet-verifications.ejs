<%- include('partials/header') %>
<section class="page-heading"><p class="eyebrow">VETERINARIAN REVIEW</p><h1>Verification requests assigned to you</h1><p>Review the member’s evidence and approve only when you are comfortable supporting their identity and animal-care claims.</p></section>
<section class="section"><% if (applications.length) { %><div class="offer-grid"><% applications.forEach(item => { %><article class="offer-card"><div class="offer-summary-top"><span class="offer-status status-<%= item.status.toLowerCase().replaceAll(' ','-') %>"><%= item.status %></span><small><%= new Date(item.updated_at || item.created_at).toLocaleDateString() %></small></div><h2><%= item.username %></h2><p><%= item.applicant_type %> · <%= item.address %></p><dl class="facts-grid"><div><dt>ID evidence</dt><dd><%= item.government_id_type %> · <%= item.government_id_reference %></dd></div><div><dt>Residence reference</dt><dd><%= item.residence_proof_reference %></dd></div><div><dt>Experience</dt><dd><%= item.pet_experience %></dd></div><div><dt>Contact</dt><dd><%= item.phone %> · <%= item.email %></dd></div></dl><% if (item.proof_document) { %><a class="document-tile" href="<%= item.proof_document %>" target="_blank" rel="noopener"><span>🪪</span><div><strong>Open private supporting proof</strong><small>Use only for this review</small></div></a><% } %><form method="post" action="/vet/verifications/<%= item.id %>/decision" class="offer-chat-action"><textarea name="reviewer_notes" rows="3" placeholder="Add a note for the applicant"><%= item.reviewer_notes || '' %></textarea><button class="button" name="decision" value="approve">Approve and verify</button><button class="button button-soft" name="decision" value="reject">Do not approve</button></form></article><% }) %></div><% } else { %><div class="empty-state"><h2>No requests assigned to you.</h2><p>When a member selects you as their reviewing vet, the request will appear here live.</p></div><% } %></section>
<%- include('partials/footer') %>
