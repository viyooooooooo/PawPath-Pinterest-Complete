<%- include('partials/header') %><section class="form-page wide-form"><div class="form-intro"><span class="kicker">PAWPATH VERIFICATION</span><h1>Trust takes more than a blue tick.</h1><p>Verification is optional for browsing and community help. It is strongly preferred for permanent adoption, repeated fostering and professional listings. PawPath reviews references but never publishes document numbers.</p></div><form class="main-form" method="post" action="/verification/apply" data-validate><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><div class="process-steps"><span><b>1</b>Identity</span><span><b>2</b>Residence</span><span><b>3</b>Veterinary reference</span><span><b>4</b>Welfare commitment</span></div><div class="form-section"><h2>Your role and identity</h2><div class="form-grid"><label>Applying as<select name="applicant_type" required><option value="">Choose</option><% ['Adopter','Independent rescuer','Foster volunteer','Community feeder','Veterinarian / clinic','Transport volunteer'].forEach(x => { %><option <%= values.applicant_type===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Full legal name<input name="full_name" required value="<%= values.full_name || '' %>"></label><label>Phone number<input name="phone" required pattern="[0-9]{10}" value="<%= values.phone || '' %>"></label><label>ID type<select name="government_id_type" required><option value="">Choose</option><% ['Aadhaar (last 4 digits only)','Driving licence','Passport','Voter ID'].forEach(x => { %><option <%= values.government_id_type===x?'selected':'' %>><%= x %></option><% }) %></select></label><label class="full-width">ID reference / secure document link<input name="government_id_reference" required value="<%= values.government_id_reference || '' %>" placeholder="Do not enter a full Aadhaar number"></label></div></div><div class="form-section"><h2>Residence and animal-care reference</h2><div class="form-grid"><label class="full-width">Current address<textarea name="address" required><%= values.address || '' %></textarea></label><label class="full-width">Residence proof reference / secure link<input name="residence_proof_reference" required value="<%= values.residence_proof_reference || '' %>"></label><label>Veterinarian name<input name="veterinarian_name" required value="<%= values.veterinarian_name || '' %>"></label><label>Clinic name<input name="veterinarian_clinic" required value="<%= values.veterinarian_clinic || '' %>"></label><label>Clinic contact<input name="veterinarian_contact" required value="<%= values.veterinarian_contact || '' %>"></label><label>Animal-care experience<textarea name="pet_experience" required><%= values.pet_experience || '' %></textarea></label></div></div><div class="form-section"><h2>Accountability commitments</h2><div class="check-stack"><label><input type="checkbox" name="household_consent" value="Yes" required <%= values.household_consent?'checked':'' %>>Everyone in my household consents to adoption or fostering.</label><label><input type="checkbox" name="home_visit_consent" value="Yes" required <%= values.home_visit_consent?'checked':'' %>>I consent to a video or in-person home check where appropriate.</label><label><input type="checkbox" name="welfare_commitment" value="Yes" required <%= values.welfare_commitment?'checked':'' %>>I agree to humane care, no breeding/resale, follow-up checks and return-to-rescuer terms.</label></div></div><button class="button">Submit for review</button><p class="privacy-note">For this prototype, use document references or secure links—not highly sensitive full document numbers. A production review team should access documents through encrypted storage with retention limits.</p></form></section><%- include('partials/footer') %>
