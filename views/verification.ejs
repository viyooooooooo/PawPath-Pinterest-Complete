<%- include('partials/header') %>
<section class="form-page wide-form"><div class="form-intro"><span class="kicker">PAWPATH VERIFICATION</span><h1>Trust takes more than a blue tick.</h1><p>Verification is optional for browsing and community help. It is strongly preferred for permanent adoption, repeated fostering and professional listings. A document is only evidence for a human reviewer—it is not automatic approval.</p></div>
<form class="main-form" method="post" action="/verification/apply" enctype="multipart/form-data" data-validate>
  <% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
  <div class="process-steps"><span><b>1</b>Identity</span><span><b>2</b>Evidence</span><span><b>3</b>References</span><span><b>4</b>Review</span></div>
  <div class="form-section"><h2>Your role and identity</h2><div class="form-grid"><label>Applying as<select name="applicant_type" required><option value="">Choose</option><% ['Volunteer / rescuer','Veterinarian / vet clinic','Shelter / NGO / rescue organisation','Potential adopter','Foster volunteer'].forEach(x => { %><option <%= values.applicant_type===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Full legal name<input name="full_name" required value="<%= values.full_name || '' %>"></label><label>Phone number<input name="phone" required pattern="[0-9]{10}" value="<%= values.phone || '' %>"></label><label>ID type<select name="government_id_type" required><option value="">Choose</option><% ['Aadhaar (last 4 digits only)','Driving licence','Passport','Voter ID','Veterinary registration / clinic licence','Organisation registration'].forEach(x => { %><option <%= values.government_id_type===x?'selected':'' %>><%= x %></option><% }) %></select></label><label class="full-width">ID reference / secure document link<input name="government_id_reference" required value="<%= values.government_id_reference || '' %>" placeholder="Do not enter a full Aadhaar number"></label><label class="full-width">Supporting proof <span class="optional-label">Private</span><input type="file" name="proof_document" accept="image/*,application/pdf"><small>For vets, use a registration or clinic proof; for organisations, an official registration or letter. PawPath accepts PDF/image evidence, but a human reviewer makes the final decision.</small></label></div></div>
  <div class="form-section"><h2>Residence and veterinarian review</h2><div class="form-grid"><label class="full-width">Current address<textarea name="address" required><%= values.address || '' %></textarea></label><label class="full-width">Residence proof reference / secure link<input name="residence_proof_reference" required value="<%= values.residence_proof_reference || '' %>"></label><label class="full-width">Choose the registered vet or clinic who will review you<select name="selected_vet_user_id" required><option value="">Choose a PawPath vet or clinic</option><% vets.forEach(vet => { %><option value="<%= vet.id %>" <%= Number(values.selected_vet_user_id)===Number(vet.id)?'selected':'' %>><%= vet.username %><%= vet.organisation_name ? ` · ${vet.organisation_name}` : '' %><%= vet.locality ? ` · ${vet.locality}` : '' %><%= vet.verification_status === 'Verified' ? ' · ✓ verified vet' : '' %></option><% }) %></select><small>Only a registered PawPath vet account can approve this request. They will receive it in their dashboard.</small></label><label class="full-width">Animal-care experience<textarea name="pet_experience" required><%= values.pet_experience || '' %></textarea></label></div></div>
  <div class="form-section"><h2>Accountability commitments</h2><div class="check-stack"><label><input type="checkbox" name="household_consent" value="Yes" required <%= values.household_consent?'checked':'' %>>Everyone in my household consents to adoption or fostering.</label><label><input type="checkbox" name="home_visit_consent" value="Yes" required <%= values.home_visit_consent?'checked':'' %>>I consent to a video or in-person home check where appropriate.</label><label><input type="checkbox" name="welfare_commitment" value="Yes" required <%= values.welfare_commitment?'checked':'' %>>I agree to humane care, no breeding/resale, follow-up checks and return-to-rescuer terms.</label></div></div>
  <button class="button">Send to selected vet</button><p class="privacy-note">Your selected veterinarian or clinic makes the decision. Approval automatically changes your profile to Verified.</p>
</form></section>
<%- include('partials/footer') %>
