<%- include('partials/header') %>
<section class="sos-page-head">
  <div><span class="kicker">URGENT RESPONSE BOARD</span><h1>Help that cannot wait.</h1><p>Critical medical, foster and transport needs appear here first. Read the full case before offering help.</p></div>
  <aside><strong><%= animals.length %></strong><span>open urgent cases</span></aside>
</section>
<section class="sos-safe-section">
  <div class="sos-guidance"><div><b>Before you respond</b><span>These simple checks protect both you and the animal.</span></div><ul><li>Confirm the current need</li><li>Use a clinic or documented rescuer where possible</li><li>Never send money without verification</li></ul></div>
  <div class="section sos-listings"><div class="section-heading"><div><span class="kicker">ACTIVE CASES</span><h2>Open urgent cases</h2></div><a class="text-link" href="/animals/new">Post an SOS listing →</a></div><div class="listing-grid"><% if (animals.length) { animals.forEach(animal => { %><%- include('partials/animal-card', { animal }) %><% }) } else { %><div class="empty-state">No urgent cases are open right now.</div><% } %></div></div>
</section>
<%- include('partials/footer') %>
