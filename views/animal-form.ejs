<%- include('partials/header') %>
<section class="form-page"><div class="form-intro"><p class="eyebrow">ACTION STARTS HERE</p><h1><%= formTitle %></h1><p>Clear details help the right person offer the right support. Share an approximate area, never an exact vulnerable location.</p></div><form class="main-form" method="post" action="<%= action %>" data-validate>
  <% if (errors.length) { %><div class="form-errors"><strong>Please fix these details:</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
  <div class="form-section"><h2>About the animal</h2><div class="form-grid"><label>Name or identifier<input name="name" required value="<%= animal.name || '' %>" placeholder="e.g. Brown pup near Gate 2"></label><label>Species<select name="species" required><option value="">Choose</option><% ['Dog','Cat'].forEach(x => { %><option <%= animal.species===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Gender<select name="gender" required><option value="">Choose</option><% ['Female','Male','Unknown'].forEach(x => { %><option <%= animal.gender===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Approximate age<input name="age" required value="<%= animal.age || '' %>" placeholder="e.g. 2 years"></label><label>Size<select name="size" required><option value="">Choose</option><% ['Small','Medium','Large'].forEach(x => { %><option <%= animal.size===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Colour / markings<input name="colour" required value="<%= animal.colour || '' %>"></label><label class="full-width">Temperament<input name="temperament" required value="<%= animal.temperament || '' %>" placeholder="e.g. friendly, shy, playful"></label></div></div>
  <div class="form-section"><h2>Care and current need</h2><div class="form-grid"><label>Vaccinated?<select name="vaccinated" required><option value="">Choose</option><% ['Yes','No','Partially','Unknown'].forEach(x => { %><option <%= animal.vaccinated===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Sterilised?<select name="sterilised" required><option value="">Choose</option><% ['Yes','No','Unknown'].forEach(x => { %><option <%= animal.sterilised===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Approximate locality<input name="locality" required value="<%= animal.locality || '' %>" placeholder="e.g. Vijay Nagar, Indore"></label><label>Urgency<select name="urgency" required><option value="">Choose</option><% ['Critical','Needs Help Today','Normal'].forEach(x => { %><option <%= animal.urgency===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Listing type<select name="category" required><option value="">Choose</option><% ['Up for Adoption','Urgent Foster Needed','Medical / Rescue SOS','Community Feeder Spot'].forEach(x => { %><option <%= animal.category===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Rescue status<select name="status" required><% ['Reported','Under Care','Foster Needed','Adoption Pending','Adopted','Resolved'].forEach(x => { %><option <%= animal.status===x?'selected':'' %>><%= x %></option><% }) %></select></label><label class="full-width">Medical notes<textarea name="medical_notes" rows="3" placeholder="Mention known treatment or care needs."><%= animal.medical_notes || '' %></textarea></label></div></div>
  <div class="form-section"><h2>Help people recognise them</h2><div class="form-grid"><label class="full-width">Photo URL<input name="photo_url" type="url" value="<%= animal.photo_url || '' %>" placeholder="https://example.com/photo.jpg"></label><label class="full-width">Kind description<textarea name="description" required minlength="20" rows="5" placeholder="Tell people where they were found and what kind of support would help."><%= animal.description || '' %></textarea><small>At least 20 characters.</small></label></div></div><button class="button" type="submit"><%= animal.id ? 'Save changes' : 'Create animal profile' %></button></form></section>
<%- include('partials/footer') %>
