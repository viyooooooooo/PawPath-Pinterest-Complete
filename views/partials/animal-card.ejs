<article class="pin-card <%= animal.urgency === 'Critical' ? 'pin-critical' : '' %>">
  <a href="/animals/<%= animal.id %>" class="pin-image"><img src="<%= animal.photo_url || 'https://images.unsplash.com/photo-1450778869180-41d0601e046e?auto=format&fit=crop&w=900&q=80' %>" alt="<%= animal.name %>" loading="lazy"><span class="pin-save">View profile ↗</span></a>
  <div class="pin-copy"><div class="pin-labels"><span class="pin-status <%= animal.urgency === 'Critical' ? 'status-critical' : '' %>"><%= animal.urgency === 'Critical' ? 'SOS' : animal.category.replace('Up for ', '') %></span><% if (animal.vaccinated === 'Yes') { %><span class="vaccinated">vaccinated</span><% } %></div><h3><a href="/animals/<%= animal.id %>"><%= animal.name %></a></h3><p><%= animal.locality %> · <%= animal.age %></p><span class="pin-need"><%= animal.category %></span></div>
</article>
