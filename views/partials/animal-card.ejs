<article class="animal-card <%= animal.urgency === 'Critical' ? 'animal-critical' : '' %>"><a class="animal-photo" href="/animals/<%= animal.id %>"><img src="<%= animal.photo_url || 'https://images.unsplash.com/photo-1450778869180-41d0601e046e?auto=format&fit=crop&w=900&q=80' %>" alt="<%= animal.name %>" loading="lazy"><span class="need-pill"><%= animal.urgency === 'Critical' ? 'URGENT SOS' : animal.category %></span></a><div class="animal-copy"><div><h3><a href="/animals/<%= animal.id %>"><%= animal.name %></a></h3><p><%= animal.species %> · <%= animal.age %> · <%= animal.locality %></p></div><div class="owner-line"><span><%= (animal.username || 'PawPath member').charAt(0) %></span><small>Listed by <b><%= animal.username || 'PawPath member' %></b> <% if (animal.verification_status === 'Verified') { %><i>✓ verified</i><% } %></small></div><a class="card-arrow" href="/animals/<%= animal.id %>">View details →</a></div></article>
