<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="PawPath connects verified rescuers, adopters and volunteers with animals who need help."><title><%= title %></title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body><header class="site-header"><a class="brand" href="/"><span class="brand-mark">P</span><span>PawPath</span></a><nav class="main-nav" aria-label="Primary navigation"><a href="/">Explore</a><a href="/animals">Listings</a><a href="/profiles">Verified people</a><a class="sos-link" href="/sos">SOS</a></nav><div class="nav-actions"><% if (currentUser) { %><a class="avatar" href="/dashboard"><%= currentUser.username.charAt(0).toUpperCase() %></a><form action="/logout" method="post"><button class="logout-button">Log out</button></form><% } else { %><a class="login-link" href="/login">Log in</a><a class="button button-small" href="/signup">Join PawPath</a><% } %></div><button class="menu-button" aria-label="Open menu" aria-expanded="false">☰</button></header><main><% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
