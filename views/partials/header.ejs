<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="PawPath is a visual discovery platform for local rescue, fostering and adoption.">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/"><span class="brand-paw">✦</span><span>PawPath</span></a>
    <nav class="main-nav" aria-label="Primary navigation"><a href="/animals">Explore</a><a href="/sos">Rescue SOS</a><a href="/foster">Foster</a><a href="/community">Community Care</a></nav>
    <div class="nav-actions"><a class="nav-search" href="/animals" aria-label="Search animal listings">⌕</a><% if (currentUser) { %><a class="avatar" href="/dashboard" title="My PawPath"><%= currentUser.username.charAt(0).toUpperCase() %></a><form action="/logout" method="post"><button class="logout-button">Log out</button></form><% } else { %><a class="login-link" href="/login">Log in</a><a class="button button-small" href="/signup">Join</a><% } %></div>
    <button class="menu-button" aria-label="Open menu" aria-expanded="false">☰</button>
  </header>
  <main><% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
