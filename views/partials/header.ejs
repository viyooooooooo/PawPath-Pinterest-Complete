<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="PawPath connects rescuers, adopters, volunteers, veterinary services and animal-welfare organisations with animals who need help.">
  <title><%= title || 'PawPath' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/pawpath-mark.svg?v=2">
  <link rel="apple-touch-icon" href="/images/pawpath-mark.svg?v=2">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/features.css">
  <link rel="stylesheet" href="/css/contact.css">
  <link rel="stylesheet" href="/css/branding.css">
  <link rel="stylesheet" href="/css/network.css">
  <link rel="stylesheet" href="/css/workflow.css">
  <link rel="stylesheet" href="/css/happy-tails.css">
  <link rel="stylesheet" href="/css/explore-palette.css">
  <link rel="stylesheet" href="/css/motion-polish.css">
  <link rel="stylesheet" href="/css/accountability.css">
  <% if (typeof mapAssets !== 'undefined' && mapAssets) { %>
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@6.19.0/dist/maplibre-gl.css">
    <link rel="stylesheet" href="/css/map.css">
  <% } %>
  <% if (typeof exploreAssets !== 'undefined' && exploreAssets) { %><link rel="stylesheet" href="/css/explore-motion.css"><% } %>
</head>
<body class="<%= typeof exploreAssets !== 'undefined' && exploreAssets ? 'explore-experience' : '' %><%= typeof mapAssets !== 'undefined' && mapAssets ? ' map-experience' : '' %><%= typeof happyTailsAssets !== 'undefined' && happyTailsAssets ? ' happy-tails-experience' : '' %>">
  <header class="site-header">
    <a class="brand" href="/"><img class="brand-mark" src="/images/pawpath-mark.svg" alt=""><span>PawPath</span></a>
    <nav class="main-nav" aria-label="Primary navigation">
      <a href="/">Explore</a><a href="/animals">Listings</a><a href="/happy-tails">Happy Tails</a><a href="/profiles">Network</a><a class="sos-link" href="/sos">SOS</a><a class="map-nav-link" href="/map">Map</a>
      <% if (currentUser) { %><a class="nav-with-badge" data-live-messages href="/messages">Messages<% if (unreadMessages) { %><span><%= unreadMessages > 99 ? '99+' : unreadMessages %></span><% } %></a><a class="nav-with-badge" data-live-notifications href="/notifications">Notifications<% if (unreadNotifications) { %><span><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span><% } %></a><% } %>
    </nav>
    <div class="nav-actions">
      <% if (currentUser) { %>
        <a class="avatar" href="/dashboard"><%= currentUser.username.charAt(0).toUpperCase() %></a>
        <form action="/logout" method="post"><button class="logout-button">Log out</button></form>
      <% } else { %>
        <a class="login-link" href="/login">Log in</a><a class="button button-small" href="/signup">Join PawPath</a>
      <% } %>
    </div>
    <button class="menu-button" aria-label="Open menu" aria-expanded="false">☰</button>
  </header>
  <% if (currentUser && notificationAlerts.length && currentPath !== '/notifications') { %><aside class="notification-alerts" aria-label="New activity"><% notificationAlerts.forEach(notification => { %><article><a href="/notifications/<%= notification.id %>/open"><span class="notification-symbol"><%= notification.type === 'offer' ? '🤝' : notification.type === 'message' ? '💬' : '✓' %></span><div><strong><%= notification.title %></strong><p><%= notification.body %></p></div><b>Open →</b></a><form method="post" action="/notifications/<%= notification.id %>/dismiss"><button aria-label="Dismiss notification">×</button></form></article><% }) %></aside><% } %>
  <main>
    <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
