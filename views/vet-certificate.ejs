<%- include('partials/header') %>
<section class="form-page wide-form"><div class="form-intro"><span class="kicker">VETERINARIAN CREDENTIAL</span><h1>Verify your professional registration.</h1><p>Veterinarians are not reviewed by another PawPath vet. Upload the registration certificate or professional ID issued by your State Veterinary Council or the Veterinary Council of India.</p></div><form class="main-form" method="post" action="/vet/certificate" enctype="multipart/form-data"><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><div class="form-section"><h2>Registration details</h2><div class="form-grid"><label>Registration number<input name="vet_registration_number" required value="<%= profile.vet_registration_number || '' %>"></label><label>Issuing veterinary council<input name="vet_council_name" required value="<%= profile.vet_council_name || '' %>" placeholder="e.g. Madhya Pradesh State Veterinary Council"></label><label class="full-width">Certificate / professional ID<input type="file" name="verification_document" accept="image/*,application/pdf" <%= profile.verification_document ? '' : 'required' %>><small><%= profile.verification_document ? 'A document is already stored. Choose another only to replace it.' : 'PDF or image, maximum 5 MB.' %></small></label></div></div><button class="button">Submit certificate for review</button><p class="privacy-note">Status: <strong><%= profile.vet_certificate_status || 'Not submitted' %></strong>. A certificate is evidence—not automatic proof. PawPath checks the registration details against the relevant professional register before approval.</p></form></section>
<%- include('partials/footer') %>
