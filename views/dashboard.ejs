<%- include('partials/header') %>
<section class="page-heading dashboard-heading"><div><p class="eyebrow">MY PAWPATH</p><h1>Hello, <%= currentUser.username %>.</h1><p>Offers, conversations and animals you are supporting—all in one place.</p></div><a class="button" href="/animals/new">+ Report a stray</a></section>
<% if (profile.is_admin) { %><section class="section admin-entry-card"><div><h2>Administrator control centre</h2><p>Manage accounts, listings, public-directory records, warnings, verification evidence and Happy Tales.</p></div><a class="button" href="/admin">Open admin panel →</a></section><% } %><% if (profile.entity_type === 'Veterinarian / vet clinic' && profile.verification_status === 'Verified') { %><section class="section"><a class="button" href="/vet/verifications">Review member requests assigned to me →</a></section><% } %>
<section class="section verification-panel"><div><span class="kicker">PROFILE TRUST</span><% if (profile.entity_type === 'Veterinarian / vet clinic') { %><h2><%= profile.vet_certificate_status || 'Not submitted' %></h2><p><% if (profile.verification_status==='Verified') { %>Your veterinary registration certificate has been approved. Your profile displays the verified-vet badge.<% } else if (profile.vet_certificate_status==='Under review') { %>Your certificate and registration number are being checked against the relevant professional register. You are not asked to obtain approval from another vet.<% } else if (profile.vet_certificate_status==='Rejected') { %><%= profile.vet_certificate_notes || 'The certificate could not be approved. Review the details and submit a corrected document.' %><% } else { %>Upload your veterinary registration certificate or professional ID to become a verified veterinarian.<% } %></p><% } else { %><h2><%= profile.verification_status %></h2><p><% if (profile.verification_status==='Verified') { %>Your vet-approved verification is active. Your listings display the verified badge.<% } else if (profile.verification_status==='Under review') { %>Under review by <strong><%= verification?.reviewing_vet_name || 'your selected veterinarian' %><%= verification?.reviewing_vet_clinic ? ` · ${verification.reviewing_vet_clinic}` : '' %></strong>. You can still use PawPath normally while you wait.<% } else { %>Choose a registered veterinarian or clinic to review and approve your verification.<% } %></p><% } %></div><% if (profile.entity_type === 'Veterinarian / vet clinic' && profile.verification_status!=='Verified') { %><a class="button button-soft" href="/vet/certificate"><%= profile.verification_document ? 'Review certificate submission' : 'Upload veterinary certificate' %></a><% } else if (profile.entity_type !== 'Veterinarian / vet clinic' && profile.verification_status!=='Verified') { %><a class="button button-soft" href="/verification/apply"><%= verification ? 'Review application' : 'Apply for verification' %></a><% } else { %><span class="large-check">✓</span><% } %></section>
<% if (verification?.referral_token && verification?.status === 'Awaiting vet claim') { %><section class="section referral-share-card"><div><span class="kicker">VET REFERRAL LINK</span><h2>Send this secure link to <%= verification.veterinarian_name %></h2><p>They must create a veterinarian account and complete credential verification before they can claim and review your application.</p></div><div class="referral-copy"><input id="vet-referral-link" readonly value="/vet-referral/<%= verification.referral_token %>"><button class="button" type="button" data-copy-referral>Copy link</button></div></section><script>document.querySelector('[data-copy-referral]')?.addEventListener('click',async(event)=>{const input=document.getElementById('vet-referral-link');const url=`${location.origin}${input.value}`;await navigator.clipboard.writeText(url);event.currentTarget.textContent='Copied ✓'})</script><% } %>
<section class="section dashboard-section"><div class="section-heading"><div><span class="kicker">ACTION CENTRE</span><h2>Offers received</h2></div><span class="muted"><%= received.length %> total</span></div>
  <% if (received.length) { %><div class="offer-grid"><% received.forEach(item => { %><a class="offer-summary-card <%= item.status === 'Pending' ? 'needs-attention' : '' %>" href="/offers/<%= item.id %>"><div class="offer-summary-image"><% if (item.animal_photo) { %><img src="<%= item.animal_photo %>" alt=""><% } else { %><span>🐾</span><% } %></div><div class="offer-summary-body"><div class="offer-summary-top"><span class="offer-status status-<%= item.status.toLowerCase().replaceAll(' ','-') %>"><%= item.status %></span><small><%= new Date(item.created_at).toLocaleDateString() %></small></div><h3><%= item.applicant_name %> offered <%= item.request_type.toLowerCase() %></h3><p>For <strong><%= item.animal_name %></strong> · <%= item.message %></p><div class="offer-summary-meta"><span><%= item.applicant_verification === 'Verified' ? '✓ Verified profile' : 'Unverified profile' %></span><span><%= item.compatibility_score %>% starting match</span></div><b>Review full offer →</b></div></a><% }) %></div><% } else { %><div class="empty-state"><h3>No offers yet.</h3><p>When someone offers help, it will appear here and in Notifications.</p></div><% } %>
</section>
<section class="section dashboard-section"><div class="section-heading"><div><span class="kicker">YOUR OUTREACH</span><h2>Offers you sent</h2></div></div><% if (sent.length) { %><div class="offer-grid"><% sent.forEach(item => { %><a class="offer-summary-card" href="/offers/<%= item.id %>"><div class="offer-summary-image"><% if (item.animal_photo) { %><img src="<%= item.animal_photo %>" alt=""><% } else { %><span>🐾</span><% } %></div><div class="offer-summary-body"><div class="offer-summary-top"><span class="offer-status status-<%= item.status.toLowerCase().replaceAll(' ','-') %>"><%= item.status %></span><small><%= new Date(item.created_at).toLocaleDateString() %></small></div><h3><%= item.request_type %> for <%= item.animal_name %></h3><p>Listing by <%= item.owner_name %></p><b>Open offer and conversation →</b></div></a><% }) %></div><% } else { %><p class="muted">You have not sent any help offers yet.</p><% } %></section>
<section class="section dashboard-section"><div class="section-heading"><div><span class="kicker">LISTINGS</span><h2>Animals you reported</h2></div><span class="muted"><%= listings.length %> total</span></div><% if (listings.length) { %><div class="listing-dashboard-grid"><% listings.forEach(animal => { %><article><% if (animal.photo_url) { %><img src="<%= animal.photo_url %>" alt=""><% } else { %><span class="listing-fallback">🐾</span><% } %><div><small><%= animal.category %></small><h3><%= animal.name %></h3><p><%= animal.locality %> · <%= animal.status %></p><a href="/animals/<%= animal.id %>">View</a><a href="/animals/<%= animal.id %>/edit">Edit</a></div></article><% }) %></div><% } else { %><div class="empty-state"><h2>You have not reported an animal yet.</h2><p>A detailed rescue passport can connect them to the right help.</p><a class="button" href="/animals/new">Create a listing</a></div><% } %></section>
<%- include('partials/footer') %>
