<%- include('partials/header') %>
<section class="page-heading dashboard-heading"><div><p class="eyebrow">MY PAWPATH</p><h1>Hello, <%= currentUser.username %>.</h1><p>Manage the animals you are supporting and offers from your community.</p></div><a class="button" href="/animals/new">+ Report a stray</a></section>
<section class="section dashboard-section"><div class="section-heading"><h2>My animal listings</h2><span class="muted"><%= listings.length %> total</span></div><% if (listings.length) { %><div class="dashboard-table-wrap"><table><thead><tr><th>Animal</th><th>Need</th><th>Status</th><th>Action</th></tr></thead><tbody><% listings.forEach(animal => { %><tr><td><strong><%= animal.name %></strong><br><small><%= animal.locality %></small></td><td><%= animal.category %></td><td><span class="badge"><%= animal.status %></span></td><td><a class="text-link" href="/animals/<%= animal.id %>">View</a> · <a class="text-link" href="/animals/<%= animal.id %>/edit">Edit</a></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><h2>You have not reported an animal yet.</h2><p>A detailed rescue passport can connect them to the right help.</p><a class="button" href="/animals/new">Create a profile</a></div><% } %></section>
<section class="section dashboard-section two-columns"><div><div class="section-heading"><h2>Offers received</h2></div><% if (received.length) { %><div class="request-list"><% received.forEach(item => { %><article><strong><%= item.applicant_name %></strong> wants to offer <strong><%= item.request_type %></strong> for <a href="/animals/<%= item.animal_id %>"><%= item.animal_name %></a><p><%= item.message %></p><small><%= item.locality %> · <%= item.contact_number %> · Compatibility: <strong><%= item.compatibility_score %>%</strong></small></article><% }) %></div><% } else { %><p class="muted">No offers have arrived yet.</p><% } %></div><div><div class="section-heading"><h2>My help offers</h2></div><% if (sent.length) { %><div class="request-list"><% sent.forEach(item => { %><article><strong><%= item.request_type %></strong> offer for <a href="/animals/<%= item.animal_id %>"><%= item.animal_name %></a><p>Compatibility suggestion: <strong><%= item.compatibility_score %>%</strong></p><small>Sent <%= new Date(item.created_at).toLocaleDateString() %></small></article><% }) %></div><% } else { %><p class="muted">You have not sent any help offers yet.</p><% } %></div></section>
<%- include('partials/footer') %>
