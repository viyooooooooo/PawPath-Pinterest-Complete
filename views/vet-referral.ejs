<%- include('partials/header') %>
<section class="referral-hero"><span class="kicker">VETERINARIAN REFERRAL</span><h1><%= referral.full_name %> asked <%= referral.vet_name %> to review their PawPath verification.</h1><p>This link does not grant approval power by itself. The reviewing veterinarian must use a verified professional PawPath account.</p></section>
<section class="section referral-steps"><article><b>01</b><h2>Create or open a vet account</h2><p>Use your professional identity and select “Veterinarian or vet clinic”.</p></article><article><b>02</b><h2>Verify the credential</h2><p>Submit the State Veterinary Council or VCI registration certificate for review.</p></article><article><b>03</b><h2>Claim and decide</h2><p>Return to this link, claim the request and review the volunteer’s private evidence.</p></article></section>
<section class="section referral-action"><div><span class="kicker">LISTED VETERINARIAN</span><h2><%= referral.vet_name %></h2><p><%= [referral.city,referral.state].filter(Boolean).join(', ') %></p></div><% if (!viewer) { %><div><a class="button" href="/login">Log in as the veterinarian</a><a class="button button-soft" href="/signup">Create veterinarian account</a></div><% } else if (viewer.entity_type !== 'Veterinarian / vet clinic') { %><div class="offer-warning"><strong>This account is not a veterinarian account.</strong><p>Log out and use the veterinarian’s professional account.</p></div><% } else if (viewer.verification_status !== 'Verified') { %><div><p>Your veterinarian credential must be approved first.</p><a class="button" href="/vet/certificate">Complete credential verification</a></div><% } else { %><form method="post" action="/vet-referral/<%= token %>/claim"><button class="button">Claim referral as <%= viewer.username %></button></form><% } %></section>
<%- include('partials/footer') %>
