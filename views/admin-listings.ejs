<%- include('partials/header') %><%- include('partials/admin-nav') %>
<section class="page-heading admin-heading"><h1>All animal listings</h1><p>Review every active, completed and reported listing and remove inappropriate records.</p></section>
<section class="section admin-card-grid"><% if (listings.length) { listings.forEach(item => { %><article class="admin-record-card"><% if (item.photo_url) { %><img src="<%= item.photo_url %>" alt=""><% } %><div><span class="admin-status"><%= item.status %></span><h2><a href="/animals/<%= item.id %>"><%= item.name %></a></h2><p><%= item.species %> · <%= item.category %> · <%= item.locality %></p><small>Listed by <%= item.username %> · <%= item.email %><br><%= item.offer_count %> offers · <%= item.complaint_count %> warnings</small><form method="post" action="/admin/listings/<%= item.id %>/delete" onsubmit="return confirm('Permanently delete this listing and its connected offers and updates?')"><button class="admin-danger">Delete listing</button></form></div></article><% }) } else { %><div class="empty-state">No listings exist.</div><% } %></section><%- include('partials/footer') %>
