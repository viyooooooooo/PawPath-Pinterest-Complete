<%- include('partials/header') %><%- include('partials/admin-nav') %>
<section class="page-heading admin-heading"><h1>People and registered services</h1><p>Every PawPath account, including volunteers, organisations, veterinarians and clinics.</p></section>
<section class="section admin-section"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Account</th><th>Type</th><th>Trust</th><th>Activity</th><th>Evidence</th><th>Action</th></tr></thead><tbody>
<% users.forEach(user => { %><tr><td><strong><a href="/profiles/<%= user.id %>"><%= user.username %></a></strong><small><%= user.email %><br><%= user.locality || 'No locality' %></small></td><td><%= user.entity_type %><% if (user.is_admin) { %><span class="admin-chip">Admin</span><% } %></td><td><b><%= user.verification_status %></b><small><% if (user.entity_type === 'Veterinarian / vet clinic') { %>Vet certificate: <%= user.vet_certificate_status %><% } %></small></td><td><%= user.listing_count %> listings<br><%= user.complaint_count %> warnings</td><td><% if (user.verification_document) { %><a class="text-link" href="<%= user.verification_document %>" target="_blank" rel="noopener">Open private proof ↗</a><% } else { %><span class="muted">None uploaded</span><% } %></td><td><% if (!user.is_admin) { %><form method="post" action="/admin/users/<%= user.id %>/delete" onsubmit="return confirm('Delete this account and all connected listings? This cannot be undone.')"><button class="admin-danger">Delete account</button></form><% } else { %><span class="muted">Protected</span><% } %></td></tr><% }) %>
</tbody></table></div></section><%- include('partials/footer') %>
