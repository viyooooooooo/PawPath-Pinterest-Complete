<%- include('partials/header') %><%- include('partials/admin-nav') %>
<section class="page-heading admin-heading"><h1>Clinics, shelters and organisations</h1><p>Manage source-backed public-directory records separately from registered PawPath accounts.</p></section>
<section class="section admin-section"><form class="admin-filter" method="get"><input name="q" value="<%= query %>" placeholder="Search name, city or state"><select name="category"><option value="">All categories</option><option value="vets" <%= category==='vets'?'selected':'' %>>Vets and clinics</option><option value="organisations" <%= category==='organisations'?'selected':'' %>>Shelters and organisations</option><option value="volunteers" <%= category==='volunteers'?'selected':'' %>>Volunteers</option></select><button class="button">Search</button></form><p class="muted"><%= total %> matching records · page <%= page %> of <%= pages %></p>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Category</th><th>Contact</th><th>Source status</th><th>Warnings</th><th>Action</th></tr></thead><tbody><% entries.forEach(item => { %><tr><td><strong><a href="/directory/<%= item.id %>"><%= item.name %></a></strong><small><%= [item.city,item.state].filter(Boolean).join(', ') || 'Location unavailable' %></small></td><td><%= item.category %><small><%= item.subtype || '' %></small></td><td><%= item.phone_primary || 'No phone' %><small><%= item.email || 'No email' %></small></td><td><%= item.trust_status %><small><%= item.source_checked_on || '' %></small></td><td><%= item.complaint_count %></td><td><form method="post" action="/admin/directory/<%= item.id %>/delete" onsubmit="return confirm('Remove this public-directory record?')"><button class="admin-danger">Delete record</button></form></td></tr><% }) %></tbody></table></div>
<div class="admin-pagination"><% if (page>1) { %><a class="button button-soft" href="?q=<%= encodeURIComponent(query) %>&category=<%= category %>&page=<%= page-1 %>">← Previous</a><% } %><% if (page<pages) { %><a class="button button-soft" href="?q=<%= encodeURIComponent(query) %>&category=<%= category %>&page=<%= page+1 %>">Next →</a><% } %></div></section><%- include('partials/footer') %>
