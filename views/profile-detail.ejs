<%- include('partials/header') %>
<section class="profile-hero">
  <% if (profile.profile_photo) { %><img src="<%= profile.profile_photo %>" alt="<%= profile.username %>"><% } else { %><div class="profile-initials profile-initials-hero" aria-label="<%= profile.username %>"><%= profile.username.charAt(0).toUpperCase() %></div><% } %>
  <div><span class="verified-badge <%= profile.verification_status === 'Verified' ? '' : 'unverified-badge' %>"><%= profile.verification_status === 'Verified' ? '✓ PawPath verified' : profile.verification_status === 'Under review' ? 'Verification under review' : 'Unverified' %></span><h1><%= profile.username %></h1><p class="profile-role"><%= profile.entity_type || profile.role %> · <%= profile.locality || 'Location shared privately' %></p><% if (profile.organisation_name) { %><p class="profile-organisation"><%= profile.organisation_name %></p><% } %><p><%= profile.bio %></p><div class="accountability-box"><% if (profile.verification_status === 'Verified') { %><strong>What verification means</strong><p>Identity, residence reference, veterinary reference and animal-welfare commitments were reviewed by PawPath. Continue to use your own judgement, home checks and written agreements.</p><% } else if (profile.verification_status === 'Under review') { %><strong>Verification is under review</strong><p>This account has applied for verification but has not been approved yet. You can still talk to them while confirming important details independently.</p><% } else { %><strong>Unverified profile</strong><p>This account has not been verified by PawPath. Messaging is available, but confirm identity, claims and arrangements independently before sharing money or an animal.</p><% } %></div><% if ((profile.show_phone && profile.phone) || (profile.show_public_email && profile.public_email) || (profile.show_instagram && profile.instagram_handle) || (profile.show_website && profile.website)) { %><div class="external-contact"><strong>Public contact details</strong><div><% if (profile.show_phone && profile.phone) { %><a href="tel:<%= profile.phone %>">Call · <%= profile.phone %></a><% } %><% if (profile.show_public_email && profile.public_email) { %><a href="mailto:<%= profile.public_email %>">Email</a><% } %><% if (profile.show_instagram && profile.instagram_handle) { %><a href="https://instagram.com/<%= profile.instagram_handle %>" target="_blank" rel="noopener">Instagram · @<%= profile.instagram_handle %></a><% } %><% if (profile.show_website && profile.website) { %><a href="<%= profile.website %>" target="_blank" rel="noopener">Website ↗</a><% } %></div></div><% } %></div>
</section>

<% if (currentUser && currentUser.id !== profile.id) { %>
<section class="section approach-section" id="contact">
  <div class="approach-card approach-card-chat">
    <div class="contact-copy"><span class="kicker">CONTACT <%= profile.username.toUpperCase() %></span><h2>Start a private conversation</h2><p>Ask a general question—or suggest one of your active listings and explain why their support could be a good fit.</p></div>
    <div class="contact-options">
      <form method="post" action="/profiles/<%= profile.id %>/chat" class="approach-form">
        <strong>General question</strong><label>Your opening message<textarea name="message" rows="3" maxlength="1500" placeholder="Hi <%= profile.username %>, I wanted to ask about…"></textarea></label><button class="button" type="submit">Message <%= profile.username %> →</button>
      </form>
      <% if (ownListings.length) { %>
      <form method="post" action="/profiles/<%= profile.id %>/chat" class="approach-form listing-message-form">
        <strong>Suggest an animal to <%= profile.username %></strong><label>Your active listing<select name="listing_id" id="approach-listing" required><% ownListings.forEach(listing => { const match = listingMatches.find(item => item.id === listing.id); %><option value="<%= listing.id %>" data-score="<%= match.score %>" data-name="<%= listing.name %>"><%= listing.name %> · <%= listing.locality %></option><% }) %></select></label><div class="match-score"><span>Starting compatibility</span><strong id="match-score"><%= listingMatches[0].score %>%</strong><small>A conversation prompt, not an adoption approval.</small></div><label>Why could <span id="suggestion-animal"><%= ownListings[0].name %></span> be a good fit?<textarea name="message" required minlength="12" rows="3" maxlength="1500" placeholder="Explain why you think this person or organisation could help this animal."></textarea></label><button class="button" id="suggestion-button" type="submit">Suggest <%= ownListings[0].name %> to <%= profile.username %> →</button>
      </form>
      <% } %>
    </div>
  </div>
</section>
<% } else if (!currentUser) { %>
<section class="section approach-section"><div class="approach-card"><div><span class="kicker">CONTACT PAWPATH MEMBERS</span><h2>Need advice or support?</h2><p>Log in to start a general chat or ask someone about one of your listings.</p></div><a class="button" href="/login">Log in to contact</a></div></section>
<% } %>

<section class="section"><div class="section-heading"><div><span class="kicker">LISTINGS BY <%= profile.username.toUpperCase() %></span><h2>Animals they are supporting</h2></div></div><div class="listing-grid"><% if (listings.length) { listings.forEach(animal => { animal.username=profile.username; animal.verification_status=profile.verification_status; %><%- include('partials/animal-card', { animal }) %><% }) } else { %><div class="empty-state">No active listings right now.</div><% } %></div></section>
<script>const selector=document.getElementById('approach-listing');const score=document.getElementById('match-score');const animal=document.getElementById('suggestion-animal');const button=document.getElementById('suggestion-button');if(selector&&score)selector.addEventListener('change',()=>{const choice=selector.options[selector.selectedIndex];score.textContent=`${choice.dataset.score}%`;animal.textContent=choice.dataset.name;button.textContent=`Suggest ${choice.dataset.name} to <%= profile.username %> →`;});</script>
<%- include('partials/footer') %>
