<%- include('partials/header') %><section class="profile-hero"><img src="<%= profile.profile_photo || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=500&q=80' %>" alt="<%= profile.username %>"><div><% if (profile.verification_status==='Verified') { %><span class="verified-badge">✓ PawPath verified</span><% } %><h1><%= profile.username %></h1><p class="profile-role"><%= profile.role %> · <%= profile.locality %></p><p><%= profile.bio %></p><div class="accountability-box"><strong>What verification means</strong><p>Identity, residence reference, veterinary reference and animal-welfare commitments were submitted for review. It does not replace your own conversation, home check or adoption agreement.</p></div></div></section><section class="section"><div class="section-heading"><div><span class="kicker">LISTINGS BY <%= profile.username.toUpperCase() %></span><h2>Animals they are supporting</h2></div></div><div class="listing-grid"><% if (listings.length) { listings.forEach(animal => { animal.username=profile.username; animal.verification_status=profile.verification_status; %><%- include('partials/animal-card', { animal }) %><% }) } else { %><div class="empty-state">No active listings right now.</div><% } %></div></section><%- include('partials/footer') %>
