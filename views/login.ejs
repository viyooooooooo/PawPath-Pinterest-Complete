<%- include('partials/header') %>
<section class="auth-page">
  <div class="auth-copy"><p class="eyebrow">WELCOME BACK</p><h1>Small actions create safer futures.</h1><p>Log in to report an animal, manage a rescue journey, message another PawPath member or offer a home.</p></div>
  <form class="auth-form" method="post" action="/login" data-validate>
    <h2>Log in</h2>
    <% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
    <label>Email<input name="email" type="email" required value="<%= values.email || '' %>"></label>
    <label>Password<input name="password" type="password" required minlength="8"></label>
    <label class="captcha-label">Quick check: what is <strong><%= captcha.question %></strong>?<input name="captcha_answer" inputmode="numeric" required><input type="hidden" name="captcha_token" value="<%= captchaToken %>"></label>
    <button class="button">Log in</button><p>New here? <a href="/signup">Create an account</a></p>
  </form>
</section>
<%- include('partials/footer') %>
