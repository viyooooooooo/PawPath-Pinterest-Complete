<%- include('partials/header') %><%- include('partials/admin-nav') %>
<section class="page-heading admin-heading"><h1>Member verification evidence</h1><p>Admins may inspect submitted evidence and track every decision. Only the verified veterinarian selected by the member can approve or reject a member verification.</p></section>
<section class="section admin-notice"><strong>View-only for administrators</strong><p>There are intentionally no approval buttons here. This prevents an administrator from replacing the independent veterinarian review.</p></section>
<section class="section admin-card-grid"><% if (applications.length) { applications.forEach(item => { %><article class="admin-verification-card"><div><span class="admin-status"><%= item.status %></span><small><%= new Date(item.updated_at || item.created_at).toLocaleString() %></small></div><h2><%= item.full_name %></h2><p><b><%= item.applicant_type %></b> · <%= item.username %> · <%= item.email %></p><dl><dt>Address</dt><dd><%= item.address %></dd><dt>Identity reference</dt><dd><%= item.government_id_type %> — <%= item.government_id_reference %></dd><dt>Residence proof</dt><dd><%= item.residence_proof_reference %></dd><dt>Selected reviewer</dt><dd><%= item.selected_vet_name || item.selected_directory_vet_name || item.veterinarian_name || 'Not selected' %></dd><dt>Veterinary contact</dt><dd><%= item.veterinarian_clinic %> · <%= item.veterinarian_contact %></dd><dt>Experience</dt><dd><%= item.pet_experience %></dd><dt>Consent</dt><dd>Household: <%= item.household_consent %> · Home visit: <%= item.home_visit_consent %> · Welfare: <%= item.welfare_commitment %></dd><% if (item.reviewer_notes) { %><dt>Vet decision notes</dt><dd><%= item.reviewer_notes %><%= item.reviewing_vet_name ? ` — ${item.reviewing_vet_name}` : '' %></dd><% } %></dl><% if (item.proof_document) { %><a class="document-tile" href="<%= item.proof_document %>" target="_blank" rel="noopener"><span>🪪</span><div><strong>Open private supporting proof</strong><small>Restricted administrator view</small></div></a><% } else { %><p class="muted">No proof file was uploaded.</p><% } %></article><% }) } else { %><div class="empty-state">No member verification applications yet.</div><% } %></section><%- include('partials/footer') %>
