<%- include('partials/header') %>
<section class="page-heading"><span class="kicker">ACCOUNTABILITY, MADE VISIBLE</span><h1>People and organisations you can reach.</h1><p>Browse verified helpers by the support they offer. Any phone, email, Instagram or website shown has been deliberately shared by that member.</p></section>
<section class="network-tabs" aria-label="Network categories"><a class="network-tab <%= !filters.group ? 'is-active' : '' %>" href="/profiles"><b>Everyone</b><span>All verified profiles</span></a><% Object.entries(networkGroups).forEach(([key, group]) => { %><a class="network-tab <%= filters.group===key ? 'is-active' : '' %>" href="/profiles?group=<%= key %>"><b><%= group.label %></b><span>Browse this support network</span></a><% }) %></section>
<section class="filters-panel"><form class="filter-form" method="get"><input type="hidden" name="group" value="<%= filters.group || '' %>"><select name="status"><option value="Verified" <%= filters.status==='Verified'?'selected':'' %>>Verified only</option><option value="" <%= !filters.status?'selected':'' %>>All profiles</option><option value="Under review" <%= filters.status==='Under review'?'selected':'' %>>Under review</option></select><select name="role"><option value="">All roles</option><% ['Independent rescuer','Veterinarian','Verified adopter','Foster volunteer','Community feeder','Transport volunteer'].forEach(role => { %><option <%= filters.role===role?'selected':'' %>><%= role %></option><% }) %></select><button class="button button-small">Apply filters</button></form></section>
<section class="section"><div class="profile-grid"><% if (profiles.length) { profiles.forEach(profile => { %><article class="profile-card"><% if (profile.profile_photo) { %><img src="<%= profile.profile_photo %>" alt="<%= profile.username %>"><% } else { %><div class="profile-initials" aria-label="<%= profile.username %>"><%= profile.username.charAt(0).toUpperCase() %></div><% } %><div><div class="profile-title"><h2><%= profile.username %></h2><% if (profile.verification_status==='Verified') { %><span>✓ Verified</span><% } %></div><p class="profile-role"><%= profile.entity_type || profile.role %> · <%= profile.locality || 'Location shared privately' %></p><p><%= profile.bio || 'A PawPath community member supporting safer animal-care outcomes.' %></p><b><%= profile.listing_count %> active listing<%= Number(profile.listing_count)===1?'':'s' %></b><div class="profile-actions"><a class="text-link" href="/profiles/<%= profile.id %>">View profile →</a><% if (currentUser && profile.verification_status === 'Verified') { %><a class="button button-small" href="/profiles/<%= profile.id %>#contact">Message / connect</a><% } %></div></div></article><% }) } else { %><div class="empty-state">No profiles match these filters yet.</div><% } %></div></section>
<%- include('partials/footer') %>
