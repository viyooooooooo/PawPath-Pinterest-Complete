<%- include('partials/header') %>
<section class="page-heading"><span class="kicker">ACCOUNTABILITY, MADE VISIBLE</span><h1>Verified people behind the listings.</h1><p>Explore rescuers, adopters, foster volunteers, community feeders and veterinary professionals whose identity and references have been reviewed.</p></section>
<section class="filters-panel"><form class="filter-form" method="get"><select name="status"><option value="Verified" <%= filters.status==='Verified'?'selected':'' %>>Verified only</option><option value="" <%= !filters.status?'selected':'' %>>All profiles</option><option value="Under review" <%= filters.status==='Under review'?'selected':'' %>>Under review</option></select><select name="role"><option value="">All roles</option><% ['Independent rescuer','Veterinarian','Verified adopter','Foster volunteer','Community feeder','Transport volunteer'].forEach(role => { %><option <%= filters.role===role?'selected':'' %>><%= role %></option><% }) %></select><button class="button button-small">Filter people</button></form></section>
<section class="section"><div class="profile-grid"><% profiles.forEach(profile => { %><article class="profile-card"><img src="<%= profile.profile_photo || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=500&q=80' %>" alt="<%= profile.username %>"><div><div class="profile-title"><h2><%= profile.username %></h2><% if (profile.verification_status==='Verified') { %><span>✓ Verified</span><% } %></div><p class="profile-role"><%= profile.role %> · <%= profile.locality %></p><p><%= profile.bio || 'A PawPath community member supporting safer animal-care outcomes.' %></p><b><%= profile.listing_count %> active listing<%= Number(profile.listing_count)===1?'':'s' %></b><div class="profile-actions"><a class="text-link" href="/profiles/<%= profile.id %>">View profile →</a><% if (currentUser && currentUser.id !== profile.id && profile.verification_status === 'Verified') { %><a class="button button-small" href="/profiles/<%= profile.id %>#contact">Message / connect</a><% } %></div></div></article><% }) %></div></section>
<%- include('partials/footer') %>
