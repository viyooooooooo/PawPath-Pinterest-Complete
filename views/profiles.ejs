<%- include('partials/header') %>
<% const allCount = Object.values(counts).reduce((sum, count) => sum + Number(count || 0), 0); %>
<% const tabUrl = (group) => { const params = new URLSearchParams(); if (group) params.set('group', group); if (filters.q) params.set('q', filters.q); if (filters.state) params.set('state', filters.state); if (filters.trust !== 'all') params.set('trust', filters.trust); return `/profiles${params.toString() ? `?${params}` : ''}`; }; %>
<section class="page-heading network-heading">
  <span class="kicker">INDIA-WIDE PAWPATH NETWORK</span>
  <h1>People and organisations you can reach.</h1>
  <p>Search PawPath members, source-checked rescue contacts, veterinary services and organisations on the official AWBI register.</p>
</section>

<section class="network-tabs" aria-label="Network categories">
  <a class="network-tab <%= !filters.group ? 'is-active' : '' %>" href="<%= tabUrl('') %>"><b>Everyone</b><span><%= allCount.toLocaleString('en-IN') %> records</span></a>
  <% Object.entries(networkGroups).forEach(([key, group]) => { %>
    <a class="network-tab <%= filters.group===key ? 'is-active' : '' %>" href="<%= tabUrl(key) %>"><b><%= group.label %></b><span><%= Number(counts[key] || 0).toLocaleString('en-IN') %> records</span></a>
  <% }) %>
</section>

<section class="network-search-panel">
  <form class="network-search-form" method="get" action="/profiles">
    <input type="hidden" name="group" value="<%= filters.group %>">
    <label class="network-search-box"><span>Search the network</span><input type="search" name="q" value="<%= filters.q %>" placeholder="Name, city, state, service or AWBI code"></label>
    <label><span>Show</span><select name="trust">
      <option value="all" <%= filters.trust==='all'?'selected':'' %>>Everyone</option>
      <option value="pawpath" <%= filters.trust==='pawpath'?'selected':'' %>>PawPath verified members</option>
      <option value="source_checked" <%= filters.trust==='source_checked'?'selected':'' %>>Source-checked contacts</option>
      <option value="awbi" <%= filters.trust==='awbi'?'selected':'' %>>AWBI-recognised organisations</option>
      <option value="service_verified" <%= filters.trust==='service_verified'?'selected':'' %>>Rescue services confirmed</option>
    </select></label>
    <label><span>State</span><select name="state"><option value="">All India</option><% states.forEach(item => { %><option value="<%= item.state %>" <%= filters.state===item.state?'selected':'' %>><%= item.state %></option><% }) %></select></label>
    <button class="button">Search</button>
    <% if (filters.q || filters.state || filters.trust !== 'all') { %><a class="clear-network-filters" href="<%= filters.group ? `/profiles?group=${filters.group}` : '/profiles' %>">Clear</a><% } %>
  </form>
</section>

<section class="network-results section">
  <div class="network-result-summary"><div><span class="kicker">DIRECTORY RESULTS</span><h2><%= total.toLocaleString('en-IN') %> match<%= total===1?'':'es' %></h2></div><p>Imported records are labelled by their actual source status. Contact availability and rescue capacity should always be confirmed directly.</p></div>
  <div class="profile-grid network-profile-grid">
    <% if (profiles.length) { profiles.forEach(profile => { %>
      <% const isUser = profile.source_type === 'user'; %>
      <% const trustLabel = profile.trust_status === 'Verified' ? 'PawPath verified' : profile.trust_status === 'source_verified' ? 'Source checked' : profile.trust_status === 'official_source' ? 'Official source' : profile.listing_readiness === 'service_verified' ? 'Rescue services confirmed' : 'AWBI recognised'; %>
      <article class="profile-card network-record-card">
        <% if (profile.profile_photo) { %><img src="<%= profile.profile_photo %>" alt="<%= profile.name %>"><% } else { %><div class="profile-initials" aria-label="<%= profile.name %>"><%= profile.name.charAt(0).toUpperCase() %></div><% } %>
        <div class="network-card-content">
          <div class="profile-title"><h2><%= profile.name %></h2><span class="trust-badge trust-<%= profile.trust_status.toLowerCase().replaceAll('_','-').replaceAll(' ','-') %>"><%= trustLabel %></span></div>
          <p class="profile-role"><%= String(profile.subtype || profile.role || '').replaceAll('_',' ') %><% if (profile.location) { %> · <%= profile.location %><% } %></p>
          <% if (profile.awbi_code) { %><p class="directory-code">AWBI code <strong><%= profile.awbi_code %></strong></p><% } %>
          <p class="network-description"><%= profile.description || 'No service description is available yet.' %></p>
          <% if (isUser) { %><b><%= Number(profile.listing_count) %> active listing<%= Number(profile.listing_count)===1?'':'s' %></b><% } %>
          <div class="profile-actions">
            <a class="text-link" href="<%= isUser ? `/profiles/${profile.record_id}` : `/directory/${profile.record_id}` %>">View details →</a>
            <% if (profile.phone_primary) { %><a class="contact-chip" href="tel:<%= profile.phone_primary %>">Call</a><% } %>
            <% if (profile.public_email) { %><a class="contact-chip" href="mailto:<%= profile.public_email %>">Email</a><% } %>
            <% if (isUser && currentUser && profile.trust_status === 'Verified') { %><a class="button button-small" href="/profiles/<%= profile.record_id %>#contact">Message</a><% } %>
          </div>
        </div>
      </article>
    <% }) } else { %><div class="empty-state"><h2>No matching records</h2><p>Try a broader search or clear one of the filters.</p></div><% } %>
  </div>

  <% if (totalPages > 1) { %><nav class="pagination" aria-label="Network pages">
    <% if (page > 1) { %><a href="<%= pageUrl(page - 1) %>">← Previous</a><% } else { %><span></span><% } %>
    <strong>Page <%= page %> of <%= totalPages %></strong>
    <% if (page < totalPages) { %><a href="<%= pageUrl(page + 1) %>">Next →</a><% } else { %><span></span><% } %>
  </nav><% } %>
</section>
<%- include('partials/footer') %>
