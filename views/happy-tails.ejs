<%- include('partials/header') %>
<% const helpedCount = Number(happyStats?.helped || 0); const realGallery = Array.isArray(galleryAnimals) ? galleryAnimals.filter(animal => animal.photo_url).slice(0,7) : []; %>

<section class="tails-hero">
  <div class="tails-hero-collage" aria-hidden="true"><% realGallery.forEach((animal,index) => { %><img class="hero-animal-photo hero-animal-photo-<%= index+1 %>" src="<%= animal.photo_url %>" alt=""><% }) %></div>
  <div class="tails-hero-wash" aria-hidden="true"></div>
  <div class="tails-hero-copy" data-tail-reveal>
    <h1>Every rescue deserves<br><em>a beautiful after.</em></h1>
    <p>Real journeys after animals found safety, care and a family through PawPath.</p>
    <div class="tails-hero-actions"><a class="button" href="#tail-stories">Read their stories</a><a class="text-link" href="#impact-collage">See the impact ↓</a></div>
  </div>
  <div class="tails-hero-stat" data-tail-reveal><strong><%= helpedCount %></strong><span>safe next steps<br>and counting</span></div>
</section>

<section id="impact-collage" class="impact-collage">
  <div class="collage-intro" data-tail-reveal><h2>The number is made of lives, not metrics.</h2><p>Every accepted offer adds another animal to this total automatically.</p></div>
  <div class="photo-number-stage" data-impact-stage>
    <% realGallery.forEach((animal,index) => { %><figure class="collage-photo collage-photo-<%= index+1 %>"><img src="<%= animal.photo_url %>" alt="<%= animal.name %>, a PawPath dog from <%= animal.locality %>"><figcaption><%= animal.name %></figcaption></figure><% }) %>
    <strong class="solid-impact-number" data-solid-count="<%= helpedCount %>" aria-label="<%= helpedCount %> animals helped">0</strong>
    <div class="photo-number-caption"><strong><%= helpedCount %></strong><span>safe next steps and counting</span></div>
  </div>
</section>

<section id="tail-stories" class="tail-deck-section">
  <div class="tail-deck-copy" data-tail-reveal><h2>Choose a story.<br>Meet the new beginning.</h2><p>Click a name to open another card. Nothing changes while you scroll.</p></div>
  <% if (stories.length) { %><div class="tail-deck" data-tail-deck aria-label="Happy Tails story cards">
    <div class="tail-card-stage"><% stories.forEach((story,index) => { %><article class="tail-flashcard <%= index===0?'is-active':'' %>" data-tail-card="<%= index %>" aria-hidden="<%= index===0?'false':'true' %>"><div class="tail-card-photo"><% if (story.after_photo_url) { %><img src="<%= story.after_photo_url %>" alt="<%= story.dog_name %> after adoption"><% } else { %><div class="happy-photo-fallback"><span>♡</span><small>Photo optional.<br>The story still matters.</small></div><% } %></div><div class="tail-card-story"><small>HAPPY TAIL #<%= String(story.id).padStart(2,'0') %></small><h3><%= story.dog_name %></h3><h2><%= story.title %></h2><p><%= story.story_text %></p><footer>Shared by <strong><%= story.username || 'a PawPath family' %></strong> · <%= new Date(story.created_at).toLocaleDateString('en-IN',{month:'long',year:'numeric'}) %></footer><% if (currentUser && Number(currentUser.id)===Number(story.user_id)) { %><form method="post" action="/happy-tails/<%= story.id %>/delete" class="tail-delete-form" onsubmit="return confirm('Delete this Happy Tail? This cannot be undone.')"><button type="submit">Delete my story</button></form><% } %></div></article><% }) %></div>
    <nav class="tail-card-picker" aria-label="Choose a Happy Tail"><% stories.forEach((story,index) => { %><button type="button" class="<%= index===0?'is-active':'' %>" data-tail-pick="<%= index %>" aria-pressed="<%= index===0?'true':'false' %>"><span><%= String(index+1).padStart(2,'0') %></span><strong><%= story.dog_name %></strong></button><% }) %></nav>
  </div><% } else { %><div class="tails-empty"><span>♡</span><h2>The first happy chapter is waiting to be shared.</h2></div><% } %>
</section>

<section class="section share-tail" data-tail-reveal><div><h2>Tell us what came next.</h2><p>If your offer was accepted, share a little update. A recent photo is welcome, never required.</p></div><% if (!currentUser) { %><a class="button" href="/login">Log in to share a story</a><% } else if (!adoptedAnimals.length) { %><div class="empty-state"><p>Your accepted adoptions will appear here when they are ready for a Happy Tail.</p></div><% } else { %><form method="post" action="/happy-tails" enctype="multipart/form-data" class="happy-form"><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><label>Adopted animal<select name="animal_id" required><option value="">Choose</option><% adoptedAnimals.forEach(animal => { %><option value="<%= animal.id %>"><%= animal.name %></option><% }) %></select></label><label>Story title<input name="title" required minlength="5" placeholder="e.g. From street naps to sofa naps"></label><label>What is life like now?<textarea name="story_text" required minlength="40" rows="5"></textarea></label><label>Recent photo <span class="optional-label">Optional</span><input type="file" name="after_photo" accept="image/*"></label><button class="button">Publish our Happy Tail ♡</button></form><% } %></section>
<%- include('partials/footer') %>
