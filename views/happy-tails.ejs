<%- include('partials/header') %>
<% const helpedCount = Number(happyStats?.helped || 0); %>
<div class="tails-progress" aria-hidden="true"><span></span></div>
<section class="tails-hero" data-tail-hero>
  <div class="tails-hero-glow" aria-hidden="true"></div>
  <div class="tails-hero-copy" data-tail-reveal><span class="kicker">HAPPY TAILS · PAWPATH</span><h1>Every rescue deserves an <em>after.</em></h1><p>Offers become introductions. Introductions become safe homes. These are the chapters that came next.</p><a class="button button-light" href="#tail-stories">Meet the happy tails ↓</a></div>
  <div class="tails-counter" data-tail-counter data-count="<%= helpedCount %>" aria-label="<%= helpedCount %> animals helped through accepted offers"><span>ANIMALS HELPED</span><strong>0</strong><p>through accepted PawPath offers</p><div class="counter-rings" aria-hidden="true"><i></i><i></i><i></i></div></div>
  <div class="tails-marquee" aria-hidden="true"><span>SAFE HOME · SECOND CHANCE · HAPPY TAIL · </span><span>SAFE HOME · SECOND CHANCE · HAPPY TAIL · </span></div>
</section>
<section class="tails-manifesto" data-tail-scene>
  <p data-tail-reveal>Not the end of a listing.</p><h2 data-tail-reveal>The beginning of a life <span>lived safely.</span></h2>
  <div class="tails-step-row"><article data-tail-reveal><b>01</b><h3>An offer connects</h3><p>A rescuer and adopter find each other through one animal’s listing.</p></article><article data-tail-reveal><b>02</b><h3>A person accepts</h3><p>The active listing closes and the animal joins the helped counter automatically.</p></article><article data-tail-reveal><b>03</b><h3>The story continues</h3><p>Both people can share updates—and a photo is always optional.</p></article></div>
</section>
<section id="tail-stories" class="section happy-stories">
  <div class="section-heading" data-tail-reveal><div><span class="kicker">LIFE AFTER ADOPTION</span><h2>Home looks good on them.</h2></div><p><%= stories.length %> stor<%= stories.length === 1 ? 'y' : 'ies' %> shared</p></div>
  <% if (stories.length) { %><div class="happy-grid"><% stories.forEach((story,index) => { %><article class="happy-card" data-tail-card><div class="happy-photo"><% if (story.after_photo_url) { %><img src="<%= story.after_photo_url %>" alt="<%= story.dog_name %> after adoption" loading="lazy"><% } else { %><div class="happy-photo-fallback" aria-label="No photo added"><span>♡</span><small>A happy chapter<br>without a photo</small></div><% } %><span><%= index % 2 ? 'HOME SWEET HOME' : 'HAPPILY ADOPTED' %></span></div><div><small>HAPPY TAIL #<%= String(story.id).padStart(2,'0') %></small><h2><%= story.title %></h2><h3><%= story.dog_name %></h3><p><%= story.story_text %></p><footer>Shared by <strong><%= story.username || 'a PawPath family' %></strong> · <%= new Date(story.created_at).toLocaleDateString('en-IN',{month:'long',year:'numeric'}) %></footer></div></article><% }) %></div>
  <% } else { %><div class="tails-empty" data-tail-reveal><span>♡</span><h2>The first happy chapter is waiting to be shared.</h2><p>Accepted offers already count toward PawPath’s impact—even before someone adds a story.</p></div><% } %>
</section>
<section class="section share-tail" data-tail-reveal><div><span class="kicker">YOUR TURN</span><h2>Tell us what came next.</h2><p>If your offer was accepted, share a little update. A recent photo is welcome, never required.</p></div><% if (!currentUser) { %><a class="button button-light" href="/login">Log in to share a story</a><% } else if (!adoptedAnimals.length) { %><div class="empty-state"><p>Your accepted adoptions will appear here when they are ready for a Happy Tail.</p></div><% } else { %><form method="post" action="/happy-tails" enctype="multipart/form-data" class="happy-form"><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><label>Adopted animal<select name="animal_id" required><option value="">Choose</option><% adoptedAnimals.forEach(animal => { %><option value="<%= animal.id %>"><%= animal.name %></option><% }) %></select></label><label>Story title<input name="title" required minlength="5" placeholder="e.g. From street naps to sofa naps"></label><label>What is life like now?<textarea name="story_text" required minlength="40" rows="5" placeholder="Favourite toy, first walk, funny habit, new best friend..."></textarea></label><label>Recent photo <span class="optional-label">Optional</span><input type="file" name="after_photo" accept="image/*"></label><button class="button button-light">Publish our Happy Tail ♡</button></form><% } %></section>
<%- include('partials/footer') %>
