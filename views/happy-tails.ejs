<%- include('partials/header') %>
<% const helpedCount = Number(happyStats?.helped || 0); const photoStories = stories.filter(story => story.after_photo_url); %>
<div class="tails-progress" aria-hidden="true"><span></span></div>
<section class="tails-hero"><div data-tail-reveal><span class="kicker">HAPPY TAILS · PAWPATH</span><h1>One accepted offer.<br><em>A whole new life.</em></h1><p>Real journeys after PawPath animals found a safe next step.</p><a class="button" href="#impact-collage">See the impact ↓</a></div><div class="tails-hero-mark" aria-hidden="true">♡</div></section>

<section id="impact-collage" class="impact-collage" data-impact-collage>
  <div class="collage-intro" data-tail-reveal><span class="kicker">ANIMALS HELPED THROUGH ACCEPTED OFFERS</span><h2>The number is made of lives, not metrics.</h2><p>Scroll closer. Every accepted offer adds another animal to this total automatically.</p></div>
  <div class="photo-number-stage">
    <% photoStories.slice(0,8).forEach((story,index) => { %><img class="collage-photo collage-photo-<%= index+1 %>" src="<%= story.after_photo_url %>" alt="" aria-hidden="true"><% }) %>
    <svg class="photo-number" viewBox="0 0 900 620" role="img" aria-label="<%= helpedCount %> animals helped"><defs><pattern id="tail-photo-pattern" width="1" height="1"><% if (photoStories[0]) { %><image href="<%= photoStories[0].after_photo_url %>" width="900" height="620" preserveAspectRatio="xMidYMid slice"/><% } else { %><rect width="900" height="620" fill="#dce8ce"/><% } %></pattern></defs><text x="450" y="520" text-anchor="middle" fill="url(#tail-photo-pattern)"><%= helpedCount %></text></svg>
    <div class="photo-number-caption"><strong><%= helpedCount %></strong><span>safe next steps and counting</span></div>
  </div>
</section>

<section id="tail-stories" class="tail-deck-section">
  <div class="tail-deck-copy" data-tail-reveal><span class="kicker">HAPPY TAILS</span><h2>Pick a card.<br>Read what came next.</h2><p>Scroll over the story card or choose a name to move through the deck.</p></div>
  <% if (stories.length) { %><div class="tail-deck" data-tail-deck tabindex="0" aria-label="Happy Tails story cards">
    <div class="tail-card-stage"><% stories.forEach((story,index) => { %><article class="tail-flashcard <%= index===0?'is-active':'' %>" data-tail-card="<%= index %>" aria-hidden="<%= index===0?'false':'true' %>"><div class="tail-card-photo"><% if (story.after_photo_url) { %><img src="<%= story.after_photo_url %>" alt="<%= story.dog_name %> after adoption"><% } else { %><div class="happy-photo-fallback"><span>♡</span><small>Photo optional.<br>The story still matters.</small></div><% } %></div><div class="tail-card-story"><small>HAPPY TAIL #<%= String(story.id).padStart(2,'0') %></small><h3><%= story.dog_name %></h3><h2><%= story.title %></h2><p><%= story.story_text %></p><footer>Shared by <strong><%= story.username || 'a PawPath family' %></strong> · <%= new Date(story.created_at).toLocaleDateString('en-IN',{month:'long',year:'numeric'}) %></footer></div></article><% }) %></div>
    <nav class="tail-card-picker" aria-label="Choose a Happy Tail"><% stories.forEach((story,index) => { %><button class="<%= index===0?'is-active':'' %>" data-tail-pick="<%= index %>"><span><%= String(index+1).padStart(2,'0') %></span><strong><%= story.dog_name %></strong></button><% }) %></nav>
  </div><% } else { %><div class="tails-empty"><span>♡</span><h2>The first happy chapter is waiting to be shared.</h2></div><% } %>
</section>

<section class="section share-tail" data-tail-reveal><div><span class="kicker">YOUR TURN</span><h2>Tell us what came next.</h2><p>If your offer was accepted, share a little update. A recent photo is welcome, never required.</p></div><% if (!currentUser) { %><a class="button" href="/login">Log in to share a story</a><% } else if (!adoptedAnimals.length) { %><div class="empty-state"><p>Your accepted adoptions will appear here when they are ready for a Happy Tail.</p></div><% } else { %><form method="post" action="/happy-tails" enctype="multipart/form-data" class="happy-form"><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><label>Adopted animal<select name="animal_id" required><option value="">Choose</option><% adoptedAnimals.forEach(animal => { %><option value="<%= animal.id %>"><%= animal.name %></option><% }) %></select></label><label>Story title<input name="title" required minlength="5" placeholder="e.g. From street naps to sofa naps"></label><label>What is life like now?<textarea name="story_text" required minlength="40" rows="5"></textarea></label><label>Recent photo <span class="optional-label">Optional</span><input type="file" name="after_photo" accept="image/*"></label><button class="button">Publish our Happy Tail ♡</button></form><% } %></section>
<%- include('partials/footer') %>
