<%- include('partials/header') %>
<% const helpedCount = Number(happyStats?.helped || 0); const leadStory = stories[0]; %>

<section class="tails-hero">
  <div data-tail-reveal>
    <h1>One “yes” can change<br><em>an entire life.</em></h1>
    <p>Real journeys from rescue to safety, told by the people who stayed for the next chapter.</p>
    <div class="hero-actions"><a class="button" href="#tail-stories">Meet the happy tails</a><a class="text-link" href="#impact-collage"><%= helpedCount.toLocaleString('en-IN') %> lives and counting ↓</a></div>
  </div>
  <div class="tails-hero-feature" aria-label="Featured Happy Tail">
    <% if (leadStory?.after_photo_url) { %><img src="<%= leadStory.after_photo_url %>" alt="<%= leadStory.dog_name %> after adoption"><% } else { %><div class="tails-hero-art"><span>♡</span><b>SAFE<br>AT LAST</b></div><% } %>
    <div><strong><%= leadStory?.dog_name || 'The next chapter' %></strong><span><%= leadStory?.title || 'A happy story is waiting to be shared.' %></span></div>
  </div>
</section>

<section id="impact-collage" class="impact-collage">
  <div class="collage-intro" data-tail-reveal><h2>The number is made of lives, not metrics.</h2><p>Every accepted offer adds another animal to this total automatically.</p></div>
  <div class="photo-number-stage" data-tail-reveal>
    <div class="impact-tile impact-tile-1" aria-hidden="true"></div><div class="impact-tile impact-tile-2" aria-hidden="true"></div><div class="impact-tile impact-tile-3" aria-hidden="true"></div><div class="impact-tile impact-tile-4" aria-hidden="true"></div>
    <strong class="solid-impact-number" aria-label="<%= helpedCount %> animals helped"><%= helpedCount %></strong>
    <div class="photo-number-caption"><strong><%= helpedCount %></strong><span>safe next steps and counting</span></div>
  </div>
</section>

<section id="tail-stories" class="tail-deck-section">
  <div class="tail-deck-copy" data-tail-reveal><h2>Every card holds a new beginning.</h2><p>All stories stay visible. Hover, focus or tap a card to bring it forward.</p></div>
  <% if (stories.length) { %><div class="tail-deck" data-tail-deck aria-label="Happy Tails story cards">
    <div class="tail-card-stage"><% stories.forEach((story,index) => { %><article class="tail-flashcard <%= index===0?'is-active':'' %>" data-tail-card="<%= index %>" tabindex="0" style="--card-index:<%= index %>;--card-count:<%= stories.length %>"><div class="tail-card-photo"><% if (story.after_photo_url) { %><img src="<%= story.after_photo_url %>" alt="<%= story.dog_name %> after adoption"><% } else { %><div class="happy-photo-fallback"><span>♡</span><small>Photo optional.<br>The story still matters.</small></div><% } %></div><div class="tail-card-story"><small>HAPPY TAIL #<%= String(story.id).padStart(2,'0') %></small><h3><%= story.dog_name %></h3><h2><%= story.title %></h2><p><%= story.story_text %></p><footer>Shared by <strong><%= story.username || 'a PawPath family' %></strong> · <%= new Date(story.created_at).toLocaleDateString('en-IN',{month:'long',year:'numeric'}) %></footer></div></article><% }) %></div>
  </div><% } else { %><div class="tails-empty"><span>♡</span><h2>The first happy chapter is waiting to be shared.</h2></div><% } %>
</section>

<section class="section share-tail" data-tail-reveal><div><h2>Tell us what came next.</h2><p>If your offer was accepted, share a little update. A recent photo is welcome, never required.</p></div><% if (!currentUser) { %><a class="button" href="/login">Log in to share a story</a><% } else if (!adoptedAnimals.length) { %><div class="empty-state"><p>Your accepted adoptions will appear here when they are ready for a Happy Tail.</p></div><% } else { %><form method="post" action="/happy-tails" enctype="multipart/form-data" class="happy-form"><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><label>Adopted animal<select name="animal_id" required><option value="">Choose</option><% adoptedAnimals.forEach(animal => { %><option value="<%= animal.id %>"><%= animal.name %></option><% }) %></select></label><label>Story title<input name="title" required minlength="5" placeholder="e.g. From street naps to sofa naps"></label><label>What is life like now?<textarea name="story_text" required minlength="40" rows="5"></textarea></label><label>Recent photo <span class="optional-label">Optional</span><input type="file" name="after_photo" accept="image/*"></label><button class="button">Publish our Happy Tail ♡</button></form><% } %></section>
<%- include('partials/footer') %>
