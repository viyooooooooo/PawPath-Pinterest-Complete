<%- include('partials/header') %><%- include('partials/admin-nav') %>
<section class="page-heading admin-heading"><h1>Warnings and complaints</h1><p>See every report registered against a person, veterinarian, clinic, shelter, organisation or animal listing.</p></section>
<section class="section admin-card-grid"><% if (complaints.length) { complaints.forEach(item => { %><article class="admin-complaint-card"><div><span class="admin-status"><%= item.status %></span><small><%= new Date(item.created_at).toLocaleString() %></small></div><h2><%= item.target_user_name || item.target_directory_name || 'Removed record' %></h2><p><strong><%= item.category %></strong></p><p><%= item.description %></p><dl><dt>Reported by</dt><dd><%= item.reporter_name %> · <%= item.reporter_email %></dd><% if (item.animal_name) { %><dt>Related animal</dt><dd><%= item.animal_name %></dd><% } %><% if (item.evidence_reference) { %><dt>Evidence reference</dt><dd><%= item.evidence_reference %></dd><% } %></dl><form method="post" action="/admin/complaints/<%= item.id %>/status"><select name="status"><% ['Submitted','Under review','Substantiated','Resolved','Dismissed'].forEach(status => { %><option <%= item.status===status?'selected':'' %>><%= status %></option><% }) %></select><button class="button button-small">Update status</button></form></article><% }) } else { %><div class="empty-state">No complaints have been registered.</div><% } %></section><%- include('partials/footer') %>
