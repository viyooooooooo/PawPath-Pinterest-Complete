<%- include('partials/header') %>
<section class="chat-page"><a class="text-link" href="/messages">← Back to inbox</a><div class="chat-workspace"><main class="chat-window"><header class="chat-window-header"><div class="conversation-avatar"><% if (other.profile_photo) { %><img src="<%= other.profile_photo %>" alt=""><% } else { %><%= otherName.charAt(0).toUpperCase() %><% } %></div><div><h1><%= otherName %></h1><p><%= conversation.topic === 'General question' ? 'Direct message' : conversation.topic %></p></div><span class="presence-dot">● Live conversation</span></header><div class="chat-notice">Keep chat on PawPath until you are comfortable. Confirm details before meeting or transferring an animal.</div><div class="message-stack" data-message-stack data-conversation-id="<%= conversation.id %>" data-current-user-id="<%= currentUser.id %>" data-last-message-id="<%= messages.length ? messages[messages.length - 1].id : 0 %>"><% messages.forEach(message => { %><div class="message-line <%= message.sender_id === currentUser.id ? 'message-own' : '' %>"><div class="message-bubble"><p><%= message.body %></p><small><%= message.sender_id === currentUser.id ? 'You' : message.username %> · <%= new Date(message.created_at).toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'}) %></small></div></div><% }) %></div><form class="chat-compose" data-live-compose method="post" action="/messages/<%= conversation.id %>"><textarea name="body" required maxlength="1500" rows="2" placeholder="Write a message…"></textarea><button class="button" aria-label="Send message">Send →</button></form></main><aside class="chat-context">
<% if (conversation.listing_id) { %><article class="context-card"><span class="kicker">CONNECTED LISTING</span><% if (conversation.listing_photo) { %><img src="<%= conversation.listing_photo %>" alt=""><% } %><h2><%= conversation.listing_name %></h2><a class="text-link" href="/animals/<%= conversation.listing_id %>">Open listing →</a></article><% } %><% if (offer) { %><article class="context-card"><span class="kicker">OFFER STATUS</span><h2><%= offer.status %></h2><p><%= offer.request_type %> · <%= offer.compatibility_score %>% starting match</p><a class="button button-soft" href="/offers/<%= offer.id %>">View full offer</a></article><% } %><article class="context-card"><span class="kicker">PROFILE</span><h2><%= otherName %></h2><p><%= other.entity_type %><% if (other.locality) { %> · <%= other.locality %><% } %></p><span class="profile-trust <%= other.verification_status === 'Verified' ? 'verified' : '' %>"><%= other.verification_status === 'Verified' ? '✓ PawPath verified' : 'Unverified profile' %></span><a class="text-link" href="/profiles/<%= other.id %>">Open profile →</a></article></aside></div></section>
<%- include('partials/footer') %>
