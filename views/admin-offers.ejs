<%- include('partials/header') %><%- include('partials/admin-nav') %>
<section class="page-heading admin-heading"><h1>Offers and approvals</h1><p>Audit every adoption, foster, rescue and medical-support offer, including accepted and declined decisions.</p></section>
<section class="section admin-card-grid"><% if (offers.length) { offers.forEach(item => { %><article class="admin-verification-card"><div><span class="admin-status"><%= item.status %></span><small><%= new Date(item.created_at).toLocaleString() %></small></div><h2><%= item.request_type %> for <a href="/animals/<%= item.animal_id %>"><%= item.animal_name %></a></h2><dl><dt>Applicant</dt><dd><%= item.applicant_name %> · <%= item.applicant_email %></dd><dt>Listing owner</dt><dd><%= item.owner_name %> · <%= item.owner_email %></dd><dt>Locality</dt><dd><%= item.locality %></dd><dt>Contact</dt><dd><%= item.contact_number %></dd><dt>Compatibility</dt><dd><%= item.compatibility_score %>% starting match</dd><dt>Message</dt><dd><%= item.message || 'No message added' %></dd><% if (item.owner_note) { %><dt>Owner decision note</dt><dd><%= item.owner_note %></dd><% } %></dl><% if (item.support_document) { %><a class="document-tile" href="<%= item.support_document %>" target="_blank" rel="noopener"><span>📎</span><div><strong>Open support document</strong><small>Private moderation access</small></div></a><% } %><a class="text-link" href="/offers/<%= item.id %>">Open offer record →</a></article><% }) } else { %><div class="empty-state">No offers have been sent.</div><% } %></section><%- include('partials/footer') %>
