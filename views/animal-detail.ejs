<%- include('partials/header') %>
<% let vaccinationRows = []; try { vaccinationRows = JSON.parse(animal.vaccinations_done || '[]'); } catch (error) {} if (!Array.isArray(vaccinationRows)) vaccinationRows = []; const animalWithLister = animal.location_status === 'with_lister'; %>

<section class="detail-hero">
  <% if (animal.photo_url) { %><img class="detail-image" src="<%= animal.photo_url %>" alt="<%= animal.name %>" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"><% } %>
  <div class="detail-image animal-detail-placeholder" style="display:<%= animal.photo_url ? 'none' : 'grid' %>">Photo not added<small>Help identify <%= animal.name %></small></div>
  <div class="detail-copy">
    <div class="badges"><span class="badge <%= ['Critical','Needs Help Today'].includes(animal.urgency) ? 'badge-critical' : '' %>"><%= ['Critical','Needs Help Today'].includes(animal.urgency) ? `URGENT SOS · ${animal.urgency}` : animal.urgency %></span><span class="badge badge-light"><%= animal.category %></span></div>
    <h1><%= animal.name %></h1>
    <p class="detail-subtitle"><%= animal.species === 'Other' && animal.species_other ? animal.species_other : animal.species %> · <%= animal.gender %> · <%= animal.age %></p>
    <div class="listing-location-box"><span class="listing-location-icon">⌖</span><div><small><%= animalWithLister ? 'CURRENTLY WITH THE LISTER' : 'LAST SPOTTED HERE' %></small><strong><%= animal.locality %></strong><p><%= animalWithLister ? 'The lister confirmed that the animal is currently with them at this chosen location.' : 'The animal was not confirmed to be with the lister. This is where they were last seen.' %></p><% if (animal.latitude && animal.longitude) { %><a href="https://www.openstreetmap.org/?mlat=<%= animal.latitude %>&mlon=<%= animal.longitude %>#map=17/<%= animal.latitude %>/<%= animal.longitude %>" target="_blank" rel="noopener">Open selected pin ↗</a><% } %></div></div>
    <p><%= animal.description %></p>
    <div class="detail-actions"><a class="button" href="#offer-help"><%= animal.category === 'Up for Adoption' ? 'Apply to adopt' : animal.category === 'Urgent Foster Needed' ? 'Offer foster care' : 'Offer help' %></a><% if (currentUser && currentUser.id === animal.user_id) { %><a class="button button-outline" href="/animals/<%= animal.id %>/edit">Edit profile</a><form method="post" action="/animals/<%= animal.id %>/delete" data-confirm="Delete this animal listing? This cannot be undone."><button class="text-button danger-button">Delete listing</button></form><% } %></div>
  </div>
</section>

<section class="detail-layout"><div>
  <article class="detail-card"><h2>Rescue passport</h2><dl class="facts-grid"><div><dt>Temperament</dt><dd><%= animal.temperament %></dd></div><div><dt>Size</dt><dd><%= animal.size %></dd></div><div><dt>Vaccinated</dt><dd><%= animal.vaccinated %></dd></div><div><dt>Sterilised</dt><dd><%= animal.sterilised %></dd></div><div><dt>Current status</dt><dd><strong><%= animal.status %></strong></dd></div><div><dt>Reported by</dt><dd><%= animal.username %></dd></div></dl><% if (vaccinationRows.length || animal.vaccinations_required) { %><div class="vaccination-summary"><% if (vaccinationRows.length) { %><div><strong>Vaccinations given</strong><ul><% vaccinationRows.forEach(row => { %><li><%= row.name %><%= row.date ? ` · ${new Date(`${row.date}T00:00:00`).toLocaleDateString()}` : '' %></li><% }) %></ul></div><% } %><% if (animal.vaccinations_required) { %><div><strong>Vaccinations required</strong><p><%= animal.vaccinations_required %></p></div><% } %></div><% } %><% if (animal.medical_notes) { %><div class="medical-note"><strong>Medical / care note</strong><p><%= animal.medical_notes %></p></div><% } %><% if (animal.contact_details) { %><div class="medical-note"><strong>Contact / additional information</strong><p><%= animal.contact_details %></p></div><% } %></article>
  <article class="detail-card" id="journey"><div class="section-heading compact"><div><p class="eyebrow">RESCUE JOURNEY</p><h2>Updates for <%= animal.name %></h2></div></div><div class="timeline"><% if (updates.length) { updates.forEach(update => { %><div class="timeline-item"><div><small><%= update.update_type %> · <%= new Date(update.created_at).toLocaleDateString() %><%= update.is_automatic ? ' · Automatic' : ` · ${update.username}` %></small><p><%= update.update_text %></p><% if (update.photo_url) { %><img class="timeline-update-photo" src="<%= update.photo_url %>" alt="Update for <%= animal.name %>"><% } %><% if (currentUser && currentUser.id === update.user_id && !update.is_automatic) { %><form method="post" action="/updates/<%= update.id %>/delete" data-confirm="Delete this rescue update?"><button class="text-button small-danger">Delete</button></form><% } %></div></div><% }) } else { %><p class="muted">No updates yet. The animal’s profile will be updated as their journey progresses.</p><% } %></div><% if (typeof canPostUpdate !== 'undefined' && canPostUpdate) { %><form class="inline-update-form" action="/animals/<%= animal.id %>/updates" method="post" enctype="multipart/form-data"><select name="update_type"><option>Progress update</option><option>Health update</option><option>Foster appeal</option><option>Adoption update</option></select><textarea name="update_text" minlength="8" placeholder="Share a meaningful update..."></textarea><label>Photo <span class="optional-label">Optional</span><input type="file" name="update_photo" accept="image/*"></label><button class="button button-small">Post update</button></form><% } %></article>
</div>

<aside id="offer-help" class="help-card"><h2>Could you help <%= animal.name %>?</h2><p>Send an offer and choose exactly what the listing owner may review.</p>
  <% if (!currentUser) { %><a class="button" href="/login">Log in to offer help</a>
  <% } else if (currentUser.id === animal.user_id) { %><p class="muted">This is your listing. Incoming offers appear in your dashboard and notifications.</p>
  <% } else { %>
    <% if (applicationErrors.length) { %><div class="form-errors"><ul><% applicationErrors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
    <form method="post" action="/animals/<%= animal.id %>/apply" enctype="multipart/form-data" class="application-form" data-validate>
      <label>I can help by<select name="request_type" required><option value="">Choose an option</option><option <%= application.request_type==='Adoption'?'selected':'' %>>Adoption</option><option <%= application.request_type==='Foster care'?'selected':'' %>>Foster care</option><option <%= application.request_type==='Transport help'?'selected':'' %>>Transport help</option><option <%= application.request_type==='Medical support'?'selected':'' %>>Medical support</option></select></label>
      <label>Housing type<select name="housing_type" required><option value="">Choose</option><% ['Apartment','Independent house','Hostel / shared room'].forEach(x => { %><option <%= application.housing_type===x?'selected':'' %>><%= x %></option><% }) %></select></label>
      <div class="location-field application-location" data-location-picker><label>Your locality <span class="required-mark">Required</span><input name="locality" autocomplete="off" required value="<%= application.locality || '' %>" placeholder="Search a road, landmark or neighbourhood"><input type="hidden" name="latitude" value="<%= application.latitude || '' %>"><input type="hidden" name="longitude" value="<%= application.longitude || '' %>"><input type="hidden" name="location_accuracy" value="<%= application.location_accuracy || '' %>"></label><button class="detect-location" type="button" data-detect-location>⌖ Detect my location</button><div class="location-suggestions" data-location-results hidden></div><small data-location-status>Search for your locality or detect your current location.</small></div>
      <label>Pet experience<select name="pet_experience" required><option value="">Choose</option><% ['None','Some experience','Experienced pet parent'].forEach(x => { %><option <%= application.pet_experience===x?'selected':'' %>><%= x %></option><% }) %></select></label>
      <label>Daily working hours<input name="working_hours" type="number" min="0" max="24" required value="<%= application.working_hours || '' %>"></label>
      <label>10-digit contact number<input name="contact_number" pattern="[0-9]{10}" required value="<%= application.contact_number || '' %>"></label>
      <label>Anything else you would like to share? <span class="optional-label">Optional</span><textarea name="message" rows="3" placeholder="Add a note only if you want to."><%= application.message || '' %></textarea></label>
      <fieldset class="offer-sharing"><legend>What may the listing owner review?</legend><label><input type="checkbox" name="share_contact" checked> My phone and contact email</label><label><input type="checkbox" name="share_profile" checked> My complete PawPath profile</label><label><input type="checkbox" name="share_verification"> My private verification application and proof</label></fieldset>
      <label>Supporting reference <span class="optional-label">Optional</span><input type="file" name="support_document" accept="image/*,application/pdf"><small>Vet note, adopter reference or another relevant document. Only offer participants can open it.</small></label>
      <button class="button">Send detailed offer</button>
    </form><p class="compatibility-note">✦ You can track the response, message the owner and review your shared evidence after sending.</p>
  <% } %>
</aside></section>
<script src="/js/location-picker.js"></script>
<%- include('partials/footer') %>
