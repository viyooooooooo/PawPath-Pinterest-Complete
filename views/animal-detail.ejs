<%- include('partials/header') %>
<section class="detail-hero">
  <% if (animal.photo_url) { %><img class="detail-image" src="<%= animal.photo_url %>" alt="<%= animal.name %>" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"><% } %>
  <div class="detail-image animal-detail-placeholder" style="display:<%= animal.photo_url ? 'none' : 'grid' %>">Photo not added<small>Help identify <%= animal.name %></small></div>
  <div class="detail-copy"><div class="badges"><span class="badge <%= animal.urgency === 'Critical' ? 'badge-critical' : '' %>"><%= animal.urgency %></span><span class="badge badge-light"><%= animal.category %></span></div><h1><%= animal.name %></h1><p class="detail-subtitle"><%= animal.species %> · <%= animal.gender %> · <%= animal.age %> · <%= animal.locality %></p><p><%= animal.description %></p><div class="detail-actions"><a class="button" href="#offer-help"><%= animal.category === 'Up for Adoption' ? 'Apply to adopt' : animal.category === 'Urgent Foster Needed' ? 'Offer foster care' : 'Offer help' %></a><% if (currentUser && currentUser.id === animal.user_id) { %><a class="button button-outline" href="/animals/<%= animal.id %>/edit">Edit profile</a><form method="post" action="/animals/<%= animal.id %>/delete" data-confirm="Delete this animal listing? This cannot be undone."><button class="text-button danger-button">Delete listing</button></form><% } %></div></div>
</section>
<section class="detail-layout"><div>
  <article class="detail-card"><h2>Rescue passport</h2><dl class="facts-grid"><div><dt>Temperament</dt><dd><%= animal.temperament %></dd></div><div><dt>Size</dt><dd><%= animal.size %></dd></div><div><dt>Vaccinated</dt><dd><%= animal.vaccinated %></dd></div><div><dt>Sterilised</dt><dd><%= animal.sterilised %></dd></div><div><dt>Current status</dt><dd><strong><%= animal.status %></strong></dd></div><div><dt>Reported by</dt><dd><%= animal.username %></dd></div></dl><% if (animal.medical_notes) { %><div class="medical-note"><strong>Medical / care note</strong><p><%= animal.medical_notes %></p></div><% } %><% if (animal.contact_details) { %><div class="medical-note"><strong>Contact / additional information</strong><p><%= animal.contact_details %></p></div><% } %></article>
  <article class="detail-card"><div class="section-heading compact"><div><p class="eyebrow">RESCUE JOURNEY</p><h2>Updates for <%= animal.name %></h2></div></div><div class="timeline"><% if (updates.length) { updates.forEach(update => { %><div class="timeline-item"><div><small><%= update.update_type %> · <%= new Date(update.created_at).toLocaleDateString() %></small><p><%= update.update_text %></p><% if (currentUser && currentUser.id === update.user_id) { %><form method="post" action="/updates/<%= update.id %>/delete" data-confirm="Delete this rescue update?"><button class="text-button small-danger">Delete</button></form><% } %></div></div><% }) } else { %><p class="muted">No updates yet. The animal’s profile will be updated as their journey progresses.</p><% } %></div><% if (currentUser && currentUser.id === animal.user_id) { %><form class="inline-update-form" action="/animals/<%= animal.id %>/updates" method="post"><select name="update_type"><option>Progress update</option><option>Health update</option><option>Foster appeal</option><option>Adoption update</option></select><textarea name="update_text" required minlength="8" placeholder="Share a meaningful update..."></textarea><button class="button button-small">Post update</button></form><% } %></article>
</div>
<aside id="offer-help" class="help-card"><p class="eyebrow">TAKE ACTION</p><h2>Could you help <%= animal.name %>?</h2><p>Send the rescuer a thoughtful offer. This is a support request, not an instant commitment.</p><% if (!currentUser) { %><a class="button" href="/login">Log in to offer help</a><% } else if (currentUser.id === animal.user_id) { %><p class="muted">This is your listing. You can manage incoming offers in your dashboard.</p><% } else { %><% if (applicationErrors.length) { %><div class="form-errors"><ul><% applicationErrors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><form method="post" action="/animals/<%= animal.id %>/apply" class="application-form" data-validate><label>I can help by<select name="request_type" required><option value="">Choose an option</option><option <%= application.request_type==='Adoption'?'selected':'' %>>Adoption</option><option <%= application.request_type==='Foster care'?'selected':'' %>>Foster care</option><option <%= application.request_type==='Transport help'?'selected':'' %>>Transport help</option><option <%= application.request_type==='Medical support'?'selected':'' %>>Medical support</option></select></label><label>Housing type<select name="housing_type" required><option value="">Choose</option><% ['Apartment','Independent house','Hostel / shared room'].forEach(x => { %><option <%= application.housing_type===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Your locality<input name="locality" required value="<%= application.locality || '' %>"></label><label>Pet experience<select name="pet_experience" required><option value="">Choose</option><% ['None','Some experience','Experienced pet parent'].forEach(x => { %><option <%= application.pet_experience===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Daily working hours<input name="working_hours" type="number" min="0" max="24" required value="<%= application.working_hours || '' %>"></label><label>10-digit contact number<input name="contact_number" pattern="[0-9]{10}" required value="<%= application.contact_number || '' %>"></label><label>Why can you help?<textarea name="message" minlength="20" required rows="4"><%= application.message || '' %></textarea></label><button class="button">Send help offer</button></form><p class="compatibility-note">✦ You’ll receive a rule-based compatibility suggestion after applying. It is not a guarantee.</p><% } %></aside></section>
<%- include('partials/footer') %>
