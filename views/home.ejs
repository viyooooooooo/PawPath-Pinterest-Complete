<%- include('partials/header') %>
<% const featuredRescues = featured && featured.length ? featured : animals.filter(item => item.species === 'Dog').slice(0, 5); const rescueMessages = ['needs help today.', 'is waiting for a safe home.', 'deserves a second chance.', 'needs a caring foster family.', 'is ready for a kinder tomorrow.', 'is looking for a forever family.']; %>

<div class="scroll-progress" aria-hidden="true"><span></span></div>

<section class="rescue-carousel" data-rescue-carousel aria-label="Featured rescue dogs">
  <div class="rescue-carousel-pattern" aria-hidden="true"></div>
  <div class="rescue-slides">
    <% featuredRescues.forEach((animal, index) => { %>
      <article class="rescue-slide <%= index === 0 ? 'is-active' : '' %>" data-rescue-slide aria-hidden="<%= index === 0 ? 'false' : 'true' %>" style="--slide-photo:url('<%= animal.photo_url %>')">
        <div class="rescue-slide-backdrop" aria-hidden="true"></div>
        <div class="rescue-slide-photo-frame"><img class="rescue-slide-image" src="<%= animal.photo_url %>" alt="<%= animal.name %>, a rescue dog in <%= animal.locality %>"></div>
        <div class="rescue-slide-wash"></div>
        <div class="rescue-slide-content">
          <h1><%= animal.name %><span> <%= rescueMessages[index % rescueMessages.length] %></span></h1>
          <p><%= animal.description %></p>
          <div class="rescue-slide-meta">
            <span class="<%= animal.urgency === 'Critical' ? 'is-urgent' : '' %>"><%= animal.urgency === 'Critical' ? 'Urgent medical help' : animal.urgency === 'Needs Help Today' ? 'Help needed today' : animal.category %></span>
            <span><%= animal.locality %></span><span><%= animal.age %> · <%= animal.gender %></span>
          </div>
          <div class="rescue-slide-actions"><a class="button button-light" href="/animals/<%= animal.id %>">Meet <%= animal.name %></a><a class="rescue-text-link" href="/animals">See every listing ↗</a></div>
        </div>
      </article>
    <% }) %>
  </div>
  <div class="rescue-carousel-chrome">
    <div class="rescue-carousel-status"><strong><%= Number(stats.animals || 0).toLocaleString('en-IN') %></strong><span>active animal listings</span><i></i><strong><%= Number(stats.urgent || 0).toLocaleString('en-IN') %></strong><span>critical cases</span></div>
    <div class="rescue-carousel-controls">
      <button data-carousel-prev aria-label="Previous rescue">←</button>
      <div class="rescue-dots"><% featuredRescues.forEach((animal, index) => { %><button class="<%= index === 0 ? 'is-active' : '' %>" data-carousel-dot="<%= index %>" aria-label="Show <%= animal.name %>"></button><% }) %></div>
      <button data-carousel-next aria-label="Next rescue">→</button>
    </div>
  </div>
  <a class="scroll-cue" href="#explore-intro"><span>Scroll to explore</span><i>↓</i></a>
</section>

<section id="explore-intro" class="motion-manifesto" data-motion-scene>
  <div class="manifesto-orbit" aria-hidden="true"><span>HELP</span><span>FOSTER</span><span>RESCUE</span><div class="manifesto-globe"><i></i><b></b><img src="/images/pawpath-mark.svg" alt=""></div></div>
  <div class="manifesto-copy" data-reveal>
    <span class="kicker">INDORE’S ACCOUNTABLE ANIMAL-CARE NETWORK</span>
    <h2>Care should never feel <em>far away.</em></h2>
    <p>Discover animals who need help, reach trusted people and move urgent cases forward—with every next step made clearer.</p>
    <div class="hero-actions"><a class="button" href="/animals">Explore listings</a><a class="button button-soft" href="/animals/new">Report an animal</a></div>
  </div>
  <div class="manifesto-number" data-scroll-scale><strong><%= Number(stats.animals || 0) %></strong><span>animals currently listed for rescue, foster or adoption</span></div>
</section>

<section class="pathways motion-pathways">
  <a href="/animals" data-reveal><span>01</span><h2>All listings</h2><p>Adoption, fostering and community-care cases.</p><b>Browse →</b></a>
  <a href="/profiles" data-reveal><span>02</span><h2>Verified network</h2><p>Rescuers, veterinary partners and organisations.</p><b>Meet them →</b></a>
  <a class="path-sos" href="/sos" data-reveal><span>03</span><h2>Urgent SOS</h2><p>Time-sensitive medical, transport and foster needs.</p><b>Help now →</b></a>
  <a class="path-map" href="/map" data-reveal><span>04</span><h2>Live map</h2><p>Animals, clinics, rescuers and shelters across India.</p><b>Open map →</b></a>
</section>

<section class="map-story" data-map-story>
  <div class="map-story-stage">
    <div class="story-map-frame">
      <div class="story-map-copy"><span class="kicker">THE WHOLE NETWORK, IN MOTION</span><h2>Follow the path to help.</h2></div>
      <div id="homeStoryMap" class="pawpath-map story-map" data-paw-map data-mini-map aria-label="Preview of the PawPath map"></div>
      <a class="story-map-link" href="/map">Explore the full map <span>↗</span></a>
    </div>
  </div>
  <div class="map-story-steps">
    <article class="map-story-step is-active" data-story-step="0"><span>01 / DISCOVER</span><h3>See the whole care network.</h3><p>Move from India-wide context to neighbourhood-level action without losing your place.</p></article>
    <article class="map-story-step" data-story-step="1"><span>02 / GET CLOSER</span><h3>Zoom into listings near you.</h3><p>Clear dots separate everyday listings from red SOS cases that need immediate attention.</p></article>
    <article class="map-story-step" data-story-step="2"><span>03 / FIND SUPPORT</span><h3>Clinics, rescuers and shelters—one tap away.</h3><p>Switch to the Network layer to find source-checked help, then open a record for contact and trust details.</p></article>
  </div>
</section>

<section class="section feed-section motion-feed" data-motion-scene>
  <div class="section-heading" data-reveal><div><span class="kicker">EXPLORE</span><h2>Animals waiting for their next chapter</h2></div><a class="text-link" href="/animals">View all listings →</a></div>
  <div class="listing-grid motion-listing-grid"><% animals.slice(0,8).forEach((animal, index) => { %><div class="motion-card-wrap" data-reveal style="--reveal-delay:<%= (index % 4) * 70 %>ms"><%- include('partials/animal-card', { animal }) %></div><% }) %></div>
</section>

<section class="home-happy-impact" data-motion-scene>
  <a class="home-happy-orbit" href="/happy-tails" data-reveal aria-label="Read PawPath Happy Tails"><span>HAPPY TAILS</span><strong data-impact-count="<%= Number(happyStats?.helped || 0) %>">0</strong><small>animals found a next step through accepted offers</small><i aria-hidden="true">♡</i></a>
  <div data-reveal><span class="kicker">IMPACT THAT KEEPS MOVING</span><h2>Every accepted offer becomes a number worth celebrating.</h2><p>The counter grows automatically when a listing owner accepts an offer. Follow the journeys, updates and little moments after “yes”.</p><a class="text-link" href="/happy-tails">See the Happy Tails →</a></div>
</section>

<section class="profiles-band motion-profiles" data-motion-scene>
  <div class="section-heading" data-reveal><div><span class="kicker">TRUSTED NETWORK</span><h2>People doing the work</h2></div><a class="text-link" href="/profiles">See everyone →</a></div>
  <div class="profile-row"><% profiles.forEach((profile, index) => { %><a class="profile-mini" data-reveal style="--reveal-delay:<%= index * 65 %>ms" href="/profiles/<%= profile.id %>"><div class="profile-mini-initial"><%= profile.username.charAt(0).toUpperCase() %></div><div><strong><%= profile.username %> <span class="verified-dot">✓</span></strong><small><%= profile.entity_type || profile.role %></small><span><%= profile.listing_count %> listing<%= Number(profile.listing_count)===1?'':'s' %></span></div></a><% }) %></div>
</section>

<section class="sos-band motion-sos" data-motion-scene><div data-reveal><span class="kicker">NEEDS HELP NOW</span><h2>Urgency needs visibility.</h2><p>These cases need transport, treatment, supplies or temporary shelter—not silent scrolling.</p><a class="button button-light" href="/sos">Open SOS board</a></div><div class="sos-list"><% urgent.forEach((animal, index) => { %><a data-reveal style="--reveal-delay:<%= index * 90 %>ms" href="/animals/<%= animal.id %>"><img src="<%= animal.photo_url %>" alt="<%= animal.name %>"><div><b><%= animal.name %></b><span><%= animal.locality %></span></div><strong>Help →</strong></a><% }) %></div></section>
<%- include('partials/footer') %>
