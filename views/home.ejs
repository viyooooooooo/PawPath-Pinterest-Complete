<%- include('partials/header') %>
<section class="quiet-intro"><div><p class="micro-label">LOCAL RESCUE, MADE EASIER</p><h1>Find a friend.<br><em>Offer a safe pause.</em></h1><p class="intro-copy">A quieter, kinder way to connect with animals who need a home, temporary care, medical help or a familiar feeder.</p></div><div class="intro-cat" aria-label="A sleepy animated cat"><span class="cat-ear left"></span><span class="cat-ear right"></span><span class="cat-face">ᵔᴥᵔ</span><span class="cat-tail"></span></div></section>
<section class="discover-bar" aria-label="Explore PawPath"><form class="home-search" action="/animals" method="get"><span>⌕</span><input name="q" aria-label="Search PawPath" placeholder="Search locality, animal or need"><button type="submit">Search</button></form><div class="chip-row"><a href="/animals?category=Up%20for%20Adoption">Adoption</a><a href="/foster">Foster</a><a href="/sos">Medical SOS</a><a href="/community">Community Care</a><a href="/animals?vaccinated=Yes">Vaccinated</a><a href="/animals?sort=urgency">Near me ↗</a></div></section>
<section class="feed-section"><div class="feed-header"><div><p class="micro-label">DISCOVER</p><h2>Looking for a little help.</h2></div><a href="/animals" class="underlink">View every profile <span>→</span></a></div><div class="masonry-grid"><% animals.forEach(animal => { %><%- include('partials/animal-card', { animal }) %><% }) %></div></section>
<section class="nearby-strip"><div class="nearby-heading"><p class="micro-label">HAPPENING NEAR YOU</p><h2>Urgent, but not alone.</h2><p>Small offers—one lift, a temporary room, a vet contact—can change the next few days.</p></div><div class="urgent-scroll"><% urgent.forEach(animal => { %><a class="urgent-mini" href="/animals/<%= animal.id %>"><img src="<%= animal.photo_url %>" alt="<%= animal.name %>"><div><span>Needs help today</span><strong><%= animal.name %></strong><small><%= animal.locality %></small></div><b>→</b></a><% }) %></div></section>
<section class="stories-section"><div class="feed-header"><div><p class="micro-label">RESCUE STORIES</p><h2>Small updates, real movement.</h2></div></div><div class="stories-grid"><% if (stories.length) { stories.forEach((story, index) => { %><article class="story-card story-<%= index %>"><img src="<%= story.photo_url %>" alt="<%= story.animal_name %>"><div><span><%= story.update_type %></span><h3><%= story.animal_name %></h3><p><%= story.update_text %></p></div></article><% }) } else { %><article class="story-card empty-story"><div class="blink-dog">ᵔᴥᵔ</div><h3>Stories will appear here.</h3><p>Every rescue update becomes part of an animal’s journey.</p></article><% } %></div></section>
<%- include('partials/footer') %>
