<%- include('partials/header') %>
<section class="auth-page"><div class="auth-copy"><p class="eyebrow">JOIN THE NETWORK</p><h1>Be part of someone’s safe path home.</h1><p>Make an account to create rescue profiles, update an animal’s journey and offer practical help.</p></div><form class="auth-form" method="post" action="/signup" data-validate><h2>Create account</h2><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><label>Name or username<input name="username" required minlength="3" value="<%= values.username || '' %>"></label><label>Email<input name="email" type="email" required value="<%= values.email || '' %>"></label><label>Password<input name="password" type="password" required minlength="8"><small>Use at least 8 characters.</small></label><label>Confirm password<input name="confirm_password" type="password" required minlength="8"></label><label class="captcha-label">Quick check: what is <strong><%= captcha.question %></strong>?<input name="captcha_answer" inputmode="numeric" required></label><button class="button">Create my account</button><p>Already a member? <a href="/login">Log in</a></p></form></section>
<%- include('partials/footer') %>
