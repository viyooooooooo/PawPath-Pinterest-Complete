<%- include('partials/header') %><section class="auth-page"><div class="auth-copy"><span class="kicker">JOIN THE NETWORK</span><h1>Start as a member. Build trust over time.</h1><p>Every account can browse, report animals and offer help. Verification is a separate review for people seeking greater trust in permanent adoption, fostering or repeated rescue work.</p><div class="signup-path"><div><b>Standard account</b><span>Immediate access after signup</span></div><div><b>Verified account</b><span>Identity + residence + veterinary reference review</span></div></div></div><form class="auth-form" method="post" action="/signup" data-validate><h2>Create account</h2><% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><label>Name or username<input name="username" required minlength="3" value="<%= values.username || '' %>"></label><label>Email<input name="email" type="email" required value="<%= values.email || '' %>"></label><label>How do you want to help?<select name="role"><option>Community member</option><option>Potential adopter</option><option>Independent rescuer</option><option>Foster volunteer</option><option>Community feeder</option><option>Veterinarian</option></select></label><label>Locality<input name="locality" placeholder="e.g. Vijay Nagar, Indore"></label><label>Password<input name="password" type="password" required minlength="8"><small>Use at least 8 characters.</small></label><label>Confirm password<input name="confirm_password" type="password" required minlength="8"></label><label class="captcha-label">Quick check: what is <strong><%= captcha.question %></strong>?<input name="captcha_answer" inputmode="numeric" required></label><button class="button">Create standard account</button><p class="form-note">After signup, your dashboard will show the optional verification application.</p><p>Already a member? <a href="/login">Log in</a></p></form></section><%- include('partials/footer') %>
