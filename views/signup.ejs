<%- include('partials/header') %>
<section class="auth-page network-signup">
  <div class="auth-copy"><span class="kicker">JOIN THE NETWORK</span><h1>Help animals, on your own terms.</h1><p>Create a standard account first. You decide which contact details, if any, appear on your profile. Verification is reviewed separately—PawPath never treats an upload as automatic proof.</p><div class="signup-path"><div><b>Standard account</b><span>Immediate access to browse, list and help.</span></div><div><b>Verification review</b><span>Optional evidence plus a human review for trusted network profiles.</span></div></div></div>
  <form class="auth-form" method="post" action="/signup" enctype="multipart/form-data" data-validate>
    <h2>Create account</h2>
    <% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
    <label>Name or username<input name="username" required minlength="3" value="<%= values.username || '' %>"></label>
    <label>Email (private login email)<input name="email" type="email" required value="<%= values.email || '' %>"></label>
    <label>How will you participate?<select name="entity_type" required><option value="">Choose one</option><option value="Volunteer / rescuer" <%= values.entity_type==='Volunteer / rescuer'?'selected':'' %>>Volunteer, rescuer or helper</option><option value="Veterinarian / vet clinic" <%= values.entity_type==='Veterinarian / vet clinic'?'selected':'' %>>Veterinarian or vet clinic</option><option value="Shelter / NGO / rescue organisation" <%= values.entity_type==='Shelter / NGO / rescue organisation'?'selected':'' %>>Shelter, NGO or rescue organisation</option></select></label>
    <label>Role <span class="optional-label">Optional</span><input name="role" value="<%= values.role || '' %>" placeholder="e.g. foster volunteer, veterinarian"></label>
    <label>Organisation / clinic name <span class="optional-label">Optional</span><input name="organisation_name" value="<%= values.organisation_name || '' %>"></label>
    <label>Locality <span class="optional-label">Optional</span><input name="locality" value="<%= values.locality || '' %>" placeholder="e.g. Vijay Nagar, Indore"></label>
    <fieldset class="contact-preferences"><legend>Contact details <span>All optional; you control what appears on your profile.</span></legend>
      <label>Phone number <input name="phone" inputmode="numeric" pattern="[0-9]{10}" value="<%= values.phone || '' %>" placeholder="10-digit number"></label><label class="visibility-choice"><input type="checkbox" name="show_phone" <%= values.show_phone?'checked':'' %>>Show this phone number on my profile</label>
      <label>Email for public contact <input name="public_email" type="email" value="<%= values.public_email || '' %>" placeholder="Can be different from login email"></label><label class="visibility-choice"><input type="checkbox" name="show_public_email" <%= values.show_public_email?'checked':'' %>>Show this email on my profile</label>
      <label>Instagram handle <input name="instagram_handle" value="<%= values.instagram_handle || '' %>" placeholder="without @ is fine"></label><label class="visibility-choice"><input type="checkbox" name="show_instagram" <%= values.show_instagram?'checked':'' %>>Show Instagram on my profile</label>
      <label>Website <input name="website" value="<%= values.website || '' %>" placeholder="https://..."></label><label class="visibility-choice"><input type="checkbox" name="show_website" <%= values.show_website?'checked':'' %>>Show website on my profile</label>
    </fieldset>
    <label>Verification document <span class="optional-label">Optional now</span><input name="verification_document" type="file" accept="image/*,application/pdf"><small>For vets: registration/clinic proof. For rescuers or organisations: suitable identity or organisation evidence. It is private and requires human review.</small></label>
    <label>Password<input name="password" type="password" required minlength="8"><small>Use at least 8 characters.</small></label><label>Confirm password<input name="confirm_password" type="password" required minlength="8"></label>
    <label class="captcha-label">Quick check: what is <strong><%= captcha.question %></strong>?<input name="captcha_answer" inputmode="numeric" required></label>
    <button class="button">Create account</button><p class="form-note">After signup, your dashboard shows the optional verification application.</p><p>Already a member? <a href="/login">Log in</a></p>
  </form>
</section>
<%- include('partials/footer') %>
