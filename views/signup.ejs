<%- include('partials/header') %>
<section class="auth-page network-signup">
  <div class="auth-copy"><span class="kicker">JOIN THE NETWORK</span><h1>Help animals, on your own terms.</h1><p>Create a standard account first. You decide which contact details, if any, appear on your profile. Verification is reviewed separately—PawPath never treats an upload as automatic proof.</p><div class="signup-path"><div><b>Standard account</b><span>Immediate access to browse, list and help.</span></div><div><b>Verification review</b><span>Optional evidence plus a human review for trusted network profiles.</span></div></div></div>
  <form class="auth-form" method="post" action="/signup" enctype="multipart/form-data" data-validate>
    <h2>Create account</h2>
    <% if (errors.length) { %><div class="form-errors"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
    <label>Name or username<input name="username" required minlength="3" value="<%= values.username || '' %>"></label>
    <label>Email (private login email)<input name="email" type="email" required value="<%= values.email || '' %>"></label>
    <label>How will you participate?<select id="entity-type" name="entity_type" required><option value="">Choose one</option><option value="Volunteer / rescuer" <%= values.entity_type==='Volunteer / rescuer'?'selected':'' %>>Volunteer, rescuer or helper</option><option value="Veterinarian / vet clinic" <%= values.entity_type==='Veterinarian / vet clinic'?'selected':'' %>>Veterinarian or vet clinic</option><option value="Shelter / NGO / rescue organisation" <%= values.entity_type==='Shelter / NGO / rescue organisation'?'selected':'' %>>Shelter, NGO or rescue organisation</option></select></label>
    <label>Role <span class="optional-label">Optional</span><input name="role" value="<%= values.role || '' %>" placeholder="e.g. foster volunteer, veterinarian"></label>
    <label>Organisation / clinic name <span class="optional-label">Optional</span><input name="organisation_name" value="<%= values.organisation_name || '' %>"></label>
    <fieldset id="vet-credential-fields" class="contact-preferences" <%= values.entity_type==='Veterinarian / vet clinic' ? '' : 'hidden' %>><legend>Veterinary credential <span>Required for every veterinarian account.</span></legend><label>Veterinary registration number<input name="vet_registration_number" value="<%= values.vet_registration_number || '' %>" placeholder="Registration number on certificate"></label><label>Issuing Veterinary Council<input name="vet_council_name" value="<%= values.vet_council_name || '' %>" placeholder="State Veterinary Council or VCI"></label></fieldset>
    <div class="location-field" data-location-picker><label>Exact location <span class="required-mark">Required</span><input name="locality" autocomplete="off" required value="<%= values.locality || '' %>" placeholder="Search a road, landmark or neighbourhood"><input type="hidden" name="latitude" value="<%= values.latitude || '' %>"><input type="hidden" name="longitude" value="<%= values.longitude || '' %>"><input type="hidden" name="location_accuracy" value="<%= values.location_accuracy || '' %>"></label><button class="detect-location" type="button" data-detect-location>◎ Detect my location</button><div class="location-suggestions" data-location-results hidden></div><small data-location-status>Your exact address is private by default. Public cards show only the broader city/region.</small></div>
    <label class="visibility-choice address-visibility"><input type="checkbox" name="show_full_address" <%= values.show_full_address?'checked':'' %>><span><strong>Show my complete address publicly</strong><small>Leave this off to show only an approximate city/region. The exact location can still power private PawPath features.</small></span></label>
    <fieldset class="contact-preferences"><legend>Contact details <span>All optional; you control what appears on your profile.</span></legend>
      <label>Phone number <input name="phone" inputmode="numeric" pattern="[0-9]{10}" value="<%= values.phone || '' %>" placeholder="10-digit number"></label><label class="visibility-choice"><input type="checkbox" name="show_phone" <%= values.show_phone?'checked':'' %>>Show this phone number on my profile</label>
      <label>Email for public contact <input name="public_email" type="email" value="<%= values.public_email || '' %>" placeholder="Can be different from login email"></label><label class="visibility-choice"><input type="checkbox" name="show_public_email" <%= values.show_public_email?'checked':'' %>>Show this email on my profile</label>
      <label>Instagram handle <input name="instagram_handle" value="<%= values.instagram_handle || '' %>" placeholder="without @ is fine"></label><label class="visibility-choice"><input type="checkbox" name="show_instagram" <%= values.show_instagram?'checked':'' %>>Show Instagram on my profile</label>
      <label>Website <input name="website" value="<%= values.website || '' %>" placeholder="https://..."></label><label class="visibility-choice"><input type="checkbox" name="show_website" <%= values.show_website?'checked':'' %>>Show website on my profile</label>
    </fieldset>
    <label id="verification-upload">Verification document <span class="optional-label" id="verification-upload-state">Optional now</span><input name="verification_document" type="file" accept="image/*,application/pdf"><small id="verification-upload-help">For vets this certificate is compulsory. For rescuers or organisations it is optional evidence. Files remain private.</small></label>
    <label>Password<input name="password" type="password" required minlength="8"><small>Use at least 8 characters.</small></label><label>Confirm password<input name="confirm_password" type="password" required minlength="8"></label>
    <label class="captcha-label">Quick check: what is <strong><%= captcha.question %></strong>?<input name="captcha_answer" inputmode="numeric" required><input type="hidden" name="captcha_token" value="<%= captchaToken %>"></label>
    <button class="button">Create account</button><p class="form-note">After signup, your dashboard shows the optional verification application.</p><p>Already a member? <a href="/login">Log in</a></p>
  </form>
</section>
<script src="/js/location-picker.js"></script>
<script>document.addEventListener('DOMContentLoaded',()=>{const type=document.querySelector('#entity-type');const fields=document.querySelector('#vet-credential-fields');const upload=document.querySelector('input[name="verification_document"]');const state=document.querySelector('#verification-upload-state');const sync=()=>{const vet=type.value==='Veterinarian / vet clinic';fields.hidden=!vet;fields.querySelectorAll('input').forEach(input=>input.required=vet);upload.required=vet;state.textContent=vet?'Required for vets':'Optional now'};type.addEventListener('change',sync);sync()})</script>
<%- include('partials/footer') %>
