<%- include('partials/header') %><%- include('partials/admin-nav') %>
<section class="page-heading admin-heading"><h1>Manage Happy Tails</h1><p>Review and remove community-submitted stories when moderation is required.</p></section>
<section class="section admin-card-grid"><% if (stories.length) { stories.forEach(item => { %><article class="admin-record-card"><% if (item.after_photo_url) { %><img src="<%= item.after_photo_url %>" alt=""><% } %><div><h2><%= item.title %></h2><p><strong><%= item.dog_name %></strong> · shared by <%= item.username || 'Deleted account' %></p><p><%= item.story_text %></p><form method="post" action="/admin/happy-tails/<%= item.id %>/delete" onsubmit="return confirm('Delete this Happy Tail?')"><button class="admin-danger">Delete story</button></form></div></article><% }) } else { %><div class="empty-state">No Happy Tails exist.</div><% } %></section><%- include('partials/footer') %>
