<%- include('partials/header') %>
<%- include('partials/admin-nav') %>
<section class="page-heading"><p class="eyebrow">ADMIN · PROFESSIONAL CREDENTIALS</p><h1>Veterinary certificate review</h1><p>Compare the uploaded certificate and registration number with the appropriate VCI or State Veterinary Council register before approving.</p></section><section class="section"><div class="offer-grid"><% vets.forEach(vet => { %><article class="offer-card"><div class="offer-summary-top"><span class="offer-status"><%= vet.vet_certificate_status || 'Not submitted' %></span><small><%= vet.email %></small></div><h2><%= vet.username %></h2><p><%= vet.organisation_name || 'Independent veterinarian' %> · <%= vet.locality || 'Location not added' %></p><dl class="facts-grid"><div><dt>Registration number</dt><dd><%= vet.vet_registration_number || 'Not submitted' %></dd></div><div><dt>Issuing council</dt><dd><%= vet.vet_council_name || 'Not submitted' %></dd></div><div><dt>Current profile status</dt><dd><%= vet.verification_status %></dd></div><div><dt>Review method</dt><dd><%= vet.vet_certificate_provider || 'Manual professional-register check' %></dd></div></dl><% if (vet.verification_document) { %><a class="document-tile" href="<%= vet.verification_document %>" target="_blank" rel="noopener"><span>🩺</span><div><strong>Open veterinary certificate</strong><small>Private credential evidence</small></div></a><% } %><form method="post" action="/admin/vets/<%= vet.id %>/decision" class="offer-chat-action"><textarea name="notes" rows="3" placeholder="Council lookup result or correction needed"><%= vet.vet_certificate_notes || '' %></textarea><button class="button" name="decision" value="approve">Approve verified vet</button><button class="button button-soft" name="decision" value="reject">Reject / request correction</button></form></article><% }) %></div></section>
<%- include('partials/footer') %>
