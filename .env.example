# Without DATABASE_URL PawPath uses local SQLite.
# On Render, set DATABASE_URL to the Internal Database URL from Render Postgres.
DATABASE_URL=
SESSION_SECRET=replace-with-a-long-random-value

# Optional: override the automatic admin login.
PAWPATH_ADMIN_USERNAME=PawPath Admin
PAWPATH_ADMIN_EMAIL=admin@pawpath.in
PAWPATH_ADMIN_PASSWORD=PawPathAdmin2026!
